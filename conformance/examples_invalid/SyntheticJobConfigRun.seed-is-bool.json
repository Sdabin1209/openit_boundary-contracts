{
  "_comment": "개발용 시드 잡(run) 설정. 이웃은 계약 HTTP 클라이언트로 부른다(시험 대역은 배선 인자로 주입한다, D9). split.ratios는 동작 확인용 자리 표시이며 평가셋 구성(O11)은 사용자 결정이다. v1 생성 설정 키는 ADR 0010으로 제거했다.",
  "dataset_id": "ds-dev",
  "seed": true,
  "created_at": "2026-10-15T00:00:00Z",
  "action_rules_version": "2",
  "survey_schema_dir": "../../survey-service/schema",
  "adapters": {
    "question_reader": {
      "kind": "http",
      "base_url": "https://question-authoring",
      "token_secret": "QUESTION_READER_TOKEN"
    },
    "failure_store": {
      "kind": "http",
      "base_url": "https://ops-feedback",
      "token_secret": "FAILURE_STORE_TOKEN"
    }
  },
  "question_sets": [
    {
      "id": "qs-main",
      "usage": "TRAIN_POOL"
    },
    {
      "id": "qs-unseen",
      "usage": "HELD_OUT_EVAL"
    }
  ],
  "reviewed_only": true,
  "seeds": {
    "enabled": true,
    "question_set_id": "qs-main"
  },
  "split": {
    "ratios": {
      "TRAIN": 0.8,
      "VALIDATION": 0.1,
      "EVAL": 0.1
    }
  },
  "review": {
    "per_kind": 2
  },
  "regeneration": {
    "mode": "full"
  },
  "output": {
    "work_dir": "../work/dev",
    "store": {
      "kind": "file",
      "root": "../work/store"
    }
  }
