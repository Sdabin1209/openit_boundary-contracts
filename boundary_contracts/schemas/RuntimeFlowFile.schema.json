{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RuntimeFlowFile.schema.json",
  "title": "RuntimeFlowFile",
  "description": "3.4.4(검토 A-23): model-runtime 의 시험 전용 백엔드(fake·mimic) 설정 파일(MODEL_RUNTIME_FAKE_FLOW_FILE, MODEL_RUNTIME_MIMIC_FLOW_FILE). 제품 배포(GPU 추론)에서는 쓰지 않는다. `order`·`skips` 의 정본은 계약 QuestionFlowTable 이다(문진 스키마 QuestionFlow 는 survey-schema 4.0.0 에서 없어졌다). 두 형식: 문항 ID 목록(배열) 또는 객체. 객체의 모르는 키는 거부한다. 4.0.0: 생산자는 deploy(시험·데모 설정 test/fake-model)뿐이다(survey-service 는 이 파일을 만들지 않는다).",
  "x-producers": [
    "deploy"
  ],
  "x-consumers": [
    "model-runtime"
  ],
  "oneOf": [
    {
      "type": "array",
      "items": {
        "$ref": "#/$defs/QuestionId"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order"
      ],
      "properties": {
        "order": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuestionId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "slots": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/itemId"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "type"
              ],
              "properties": {
                "key": {
                  "$ref": "#/$defs/modelKey"
                },
                "type": {
                  "enum": [
                    "boolean",
                    "integer"
                  ]
                }
              }
            }
          }
        },
        "skips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SkipCondition"
          }
        },
        "corrections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contains",
              "key",
              "value"
            ],
            "properties": {
              "contains": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "key": {
                "$ref": "#/$defs/modelKey"
              },
              "value": {
                "type": [
                  "boolean",
                  "number",
                  "string"
                ]
              },
              "at": {
                "$ref": "#/$defs/itemId"
              }
            }
          }
        },
        "reasks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contains",
              "key"
            ],
            "properties": {
              "contains": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "key": {
                "$ref": "#/$defs/modelKey"
              },
              "reason": {
                "enum": [
                  "MISSING",
                  "OUT_OF_RANGE",
                  "UNKNOWN_UNIT",
                  "VAGUE_QUANTITY",
                  "RANGE_SPANS_OPTIONS",
                  "COUNT_EXCEEDS_DAYS",
                  "OTHER_BEVERAGE",
                  "BEVERAGE_MISSING",
                  "MISSING_NUMBER",
                  "UNPARSED_VALUE",
                  "INVALID_OPTION"
                ]
              },
              "at": {
                "$ref": "#/$defs/itemId"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "itemId": {
      "$ref": "#/$defs/QuestionId"
    },
    "modelKey": {
      "type": "string",
      "pattern": "^Q[0-9]+(\\.D[0-9]{2})?(_[0-9]+)?(\\[(soju|beer|spirits|makgeolli|wine)\\])?\\.[a-z][a-z_]*$(?![\\s\\S])"
    },
    "QuestionId": {
      "type": "string",
      "minLength": 1
    },
    "SlotName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.]+\\.[A-Za-z0-9_]+$(?![\\s\\S])",
      "description": "문항.칸 (종류 괄호 없음). 예: Q8_1.days"
    },
    "SkipCondition": {
      "type": "object",
      "description": "slot에 저장된 값이 value와 같으면(op '==') skip_item은 묻지 않는다. 값은 bool 또는 수 또는 문자열이다. 비교에서 bool과 수는 다르다(true != 1).",
      "properties": {
        "slot": {
          "$ref": "#/$defs/SlotName"
        },
        "op": {
          "const": "=="
        },
        "value": {
          "type": [
            "boolean",
            "number",
            "string"
          ]
        },
        "skip_item": {
          "$ref": "#/$defs/QuestionId"
        }
      },
      "required": [
        "slot",
        "op",
        "value",
        "skip_item"
      ],
      "additionalProperties": false
    }
  }
}
