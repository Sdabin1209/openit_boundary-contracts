{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CaseReviewRequest.schema.json",
  "title": "CaseReviewRequest",
  "description": "POST /v1/cases/{case_id}/review 본문(I7, Protocol 밖). 만드는 쪽: admin-console(검토자 화면). 읽는 쪽: ops-feedback. expected·reviewed_input 이 있으면 expected_kind 필수(HTTP.md I7)이고, 모양은 expected_kind 가 정한다(LORA_A: ActionExtraction·ActionExtractionInput, LORA_B: ResponseText·ResponseRequest — 3.7.0, 그 전에는 객체·문자열인지만 봤다). 화면은 CONFIRMED가 아닌 결정에는 review_status만 보낸다.",
  "x-producers": [
    "admin-console"
  ],
  "x-consumers": [
    "ops-feedback"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_status"
  ],
  "properties": {
    "review_status": {
      "enum": [
        "CONFIRMED",
        "DISMISSED",
        "PENDING"
      ]
    },
    "expected": {
      "type": [
        "object",
        "string"
      ],
      "description": "LORA_A면 ActionExtraction, LORA_B면 ResponseText"
    },
    "expected_kind": {
      "enum": [
        "LORA_A",
        "LORA_B"
      ]
    },
    "reviewed_input": {
      "type": "object",
      "description": "LORA_A면 ActionExtractionInput, LORA_B면 ResponseRequest. 개인정보 없이 고쳐 쓴 것"
    }
  },
  "dependentRequired": {
    "expected": [
      "expected_kind"
    ],
    "reviewed_input": [
      "expected_kind"
    ]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review_status": {
            "enum": [
              "DISMISSED",
              "PENDING"
            ]
          }
        },
        "required": [
          "review_status"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "expected"
              ]
            },
            {
              "required": [
                "reviewed_input"
              ]
            },
            {
              "required": [
                "expected_kind"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "expected_kind": {
            "const": "LORA_A"
          }
        },
        "required": [
          "expected_kind"
        ]
      },
      "then": {
        "properties": {
          "expected": {
            "$ref": "ActionExtraction.schema.json"
          },
          "reviewed_input": {
            "$ref": "ActionExtractionInput.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "expected_kind": {
            "const": "LORA_B"
          }
        },
        "required": [
          "expected_kind"
        ]
      },
      "then": {
        "properties": {
          "expected": {
            "$ref": "ResponseText.schema.json"
          },
          "reviewed_input": {
            "$ref": "ResponseRequest.schema.json"
          }
        }
      }
    }
  ]
}
