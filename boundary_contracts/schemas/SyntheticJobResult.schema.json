{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SyntheticJobResult.schema.json",
  "title": "SyntheticJobResult",
  "description": "synthetic-data run 과 import 가 성공·거부 시 stdout 에 내는 JSON 한 줄(sort_keys). 읽는 쪽: deploy E2E(scripts/e2e_steps.py)(status, version, content_hash, counts.rows_total·rows_valid·rows_invalid). 운영 타이머(deploy config/systemd)는 이 잡을 주기로 돌리지 않는다. 종료 코드(정본은 이 표; 코드는 __main__.py): 0 = 게시/이미 게시됨/할 일 없음, 2 = 설정 오류(stderr에 SyntheticJobError 한 줄), 3 = 재시도 불가 경계 오류(stderr에 BoundaryError 레코드), 75 = 재시도 가능 경계 오류(EX_TEMPFAIL), 4 = import가 허용치 초과 등으로 게시하지 않음(stdout에 status REJECTED). 모르는 키 정책: 읽는 쪽은 무시하고, 이 영역은 필드를 더할 수 있다. 불변식: 필드 7~8개는 항상 있다(값이 없으면 null); status가 PUBLISHED/ALREADY_PUBLISHED면 version, content_hash, dataset_digest가 null이 아니다. 이력: CR-008(2026-10-29)에서 계약으로 올렸다.",
  "x-producers": [
    "synthetic-data"
  ],
  "x-consumers": [
    "deploy"
  ],
  "type": "object",
  "required": [
    "status",
    "dataset_id",
    "version",
    "content_hash",
    "dataset_digest",
    "counts",
    "report_path"
  ],
  "properties": {
    "status": {
      "enum": [
        "PUBLISHED",
        "ALREADY_PUBLISHED",
        "NOTHING_TO_DO",
        "REJECTED"
      ],
      "description": "NOTHING_TO_DO는 run만, REJECTED는 import만."
    },
    "dataset_id": {
      "$ref": "_common.schema.json#/$defs/Id"
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_hash": {
      "oneOf": [
        {
          "$ref": "_common.schema.json#/$defs/Hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "dataset_digest": {
      "oneOf": [
        {
          "$ref": "_common.schema.json#/$defs/Hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "report_path": {
      "type": [
        "string",
        "null"
      ],
      "description": "run은 report.json, import는 import_report.json의 경로(실행한 호스트 기준)."
    },
    "rejected_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "import만 낸다. 값(행 내용)은 담지 않고 건수·사유만."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "PUBLISHED",
              "ALREADY_PUBLISHED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "version": {
            "type": "string"
          },
          "content_hash": {
            "type": "string"
          },
          "dataset_digest": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "REJECTED"
          }
        }
      },
      "then": {
        "required": [
          "rejected_reasons"
        ],
        "properties": {
          "rejected_reasons": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
