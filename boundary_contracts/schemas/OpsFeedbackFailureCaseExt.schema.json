{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "OpsFeedbackFailureCaseExt.schema.json",
  "title": "OpsFeedbackFailureCaseExt",
  "description": "FailureCase.ext[\"ops-feedback\"]의 내용. 계약의 FailureCase.ext는 영역 이름 키 아래 자유 객체다. 만드는 쪽: ops-feedback(case_builder 가 처음 쓰고 review_decider 가 review·reviewed_by 를 덧붙인다; 둘 다 쓰기 전에 이 스키마로 검증한다). 읽는 쪽: 이웃은 보존만 하는 것이 원칙이고, 읽는 이웃이 생기면 이 스키마를 기준으로 한다. 아래 키 밖은 쓰지 않는다(3.7.0에서 닫아 생산자 검증이 강제한다; 그 전에는 열려 있어 시험으로 확인되지 않던 불변식).",
  "x-producers": [
    "ops-feedback"
  ],
  "x-consumers": [
    "synthetic-data",
    "model-lab",
    "question-authoring"
  ],
  "type": "object",
  "required": [
    "detections",
    "primary_rule",
    "deid_policy_id",
    "deid_stats"
  ],
  "additionalProperties": false,
  "properties": {
    "detections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "detail"
        ],
        "additionalProperties": false,
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "detail": {
            "type": "object",
            "description": "개인정보가 없는 값만(규칙 ID, 열거값, 개수). 규칙별 키는 detect.py가 정한다."
          }
        }
      }
    },
    "primary_rule": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "deid_policy_id": {
      "type": "string",
      "minLength": 1
    },
    "deid_stats": {
      "type": "object",
      "description": "비식별 처리 건수. 값은 비음 정수, 경로 목록은 문자열 배열.",
      "properties": {
        "masked_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dropped_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": {
        "type": [
          "integer",
          "array"
        ]
      }
    },
    "pause_reason": {
      "enum": [
        "RISK",
        "REASK_LIMIT",
        "OTHER"
      ],
      "description": "정지 사유(PUBLIC_API H절). 없으면 미상. 모르는 값은 읽는 쪽이 OTHER로 취급"
    },
    "review": {
      "type": "object",
      "required": [
        "reviewer_role"
      ],
      "additionalProperties": false,
      "properties": {
        "reviewer_role": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        }
      }
    },
    "reviewed_by": {
      "$ref": "_common.schema.json#/$defs/Id",
      "description": "X-Openit-User 값 또는 토큰 역할 이름(공통 Id 형식)"
    }
  }
}
