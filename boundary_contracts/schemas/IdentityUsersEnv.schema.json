{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "IdentityUsersEnv.schema.json",
  "title": "IdentityUsersEnv",
  "description": "identity register-users 잡의 환경 변수: 관리자 암호 파일과 루트 CA 를 읽는다. identity 서버를 띄우지 않고 IDENTITY_PUBLIC_URL 도 쓰지 않는다.",
  "x-producers": [
    "deploy"
  ],
  "x-consumers": [
    "platform"
  ],
  "type": "object",
  "allOf": [
    {
      "$ref": "CommonEnv.schema.json"
    }
  ],
  "properties": {
    "IDENTITY_ADMIN_PASSWORD_FILE": {
      "$ref": "IdentityEnv.schema.json#/properties/IDENTITY_ADMIN_PASSWORD_FILE"
    },
    "IDENTITY_ROOT_CA": {
      "$ref": "IdentityEnv.schema.json#/properties/IDENTITY_ROOT_CA"
    }
  },
  "required": [
    "IDENTITY_ADMIN_PASSWORD_FILE",
    "IDENTITY_ROOT_CA"
  ],
  "propertyNames": {
    "anyOf": [
      {
        "not": {
          "pattern": "^IDENTITY_"
        }
      },
      {
        "enum": [
          "IDENTITY_ADMIN_PASSWORD_FILE",
          "IDENTITY_ROOT_CA"
        ]
      }
    ],
    "description": "접두사가 같은 이름은 아래 목록만(오타가 조용히 무시되지 않게, 3.7.0)"
  }
}
