  ],
  "x-consumers": [
    "platform"
  ],
  "type": "object",
  "allOf": [
    {
      "$ref": "CommonEnv.schema.json"
    }
  ],
  "properties": {
    "IDENTITY_ADMIN_PASSWORD_FILE": {
      "$ref": "IdentityEnv.schema.json#/properties/IDENTITY_ADMIN_PASSWORD_FILE"
    },
    "IDENTITY_ROOT_CA": {
      "$ref": "IdentityEnv.schema.json#/properties/IDENTITY_ROOT_CA"
    }
  },
  "required": [
    "IDENTITY_ADMIN_PASSWORD_FILE",
    "IDENTITY_ROOT_CA"
  ]
}
