{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "StaffStreamEvent.schema.json",
  "title": "StaffStreamEvent",
  "description": "직원 알림 SSE(text/event-stream)의 이벤트 하나: {event 이름, data}. 이름별 data 계약(HeartbeatEvent, ResyncEvent, ResultReadyEvent, 알림 이벤트)을 oneOf 로 묶는다. SSE 는 openit_link 응답 검증 밖이라 survey-service 가 이벤트마다 이 스키마로 검증한 뒤 보낸다(server.py _checked).",
  "x-producers": [
    "survey-service"
  ],
  "x-consumers": [
    "kiosk-frontend",
    "admin-console"
  ],
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "event": {
          "const": "alert"
        },
        "data": {
          "$ref": "StaffAlert.schema.json"
        }
      },
      "required": [
        "event",
        "data"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "const": "resolved"
        },
        "data": {
          "$ref": "StaffAlert.schema.json"
        }
      },
      "required": [
        "event",
        "data"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "const": "result_ready"
        },
        "data": {
          "$ref": "ResultReadyEvent.schema.json"
        }
      },
      "required": [
        "event",
        "data"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "const": "heartbeat"
        },
        "data": {
          "$ref": "HeartbeatEvent.schema.json"
        }
      },
      "required": [
        "event",
        "data"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "const": "resync"
        },
        "data": {
          "$ref": "ResyncEvent.schema.json"
        }
      },
      "required": [
        "event",
        "data"
      ],
      "additionalProperties": false
    }
  ]
}
