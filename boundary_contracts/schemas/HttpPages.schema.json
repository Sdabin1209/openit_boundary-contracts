{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "HttpPages.schema.json",
  "title": "HttpPages",
  "description": "HTTP 목록 응답 본문 묶음: 계약 ListEnvelope({items, next_cursor})에 호출별 items 원소 계약을 붙인 것($defs 마다 하나). openapi 문서의 목록 응답이 가리키고 openit_link 계약 모드가 내는 쪽에서 검증한다. ListEnvelope 의 모르는 키 정책(읽기 쪽 관용)을 따른다.",
  "x-producers": [
    "question-authoring",
    "synthetic-data",
    "model-lab",
    "release-gate",
    "ops-feedback",
    "survey-service"
  ],
  "x-consumers": [
    "*"
  ],
  "$defs": {
    "Ids": {
      "allOf": [
        {
          "$ref": "ListEnvelope.schema.json"
        },
        {
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "ArtifactRefs": {
      "allOf": [
        {
          "$ref": "ListEnvelope.schema.json"
        },
        {
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "ArtifactRef.schema.json"
              }
            }
          }
        }
      ]
    },
    "Reviews": {
      "allOf": [
        {
          "$ref": "ListEnvelope.schema.json"
        },
        {
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "ReviewRecord.schema.json"
              }
            }
          }
        }
      ]
    },
    "Releases": {
      "allOf": [
        {
          "$ref": "ListEnvelope.schema.json"
        },
        {
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "ReleaseManifest.schema.json"
              }
            }
          }
        }
      ]
    },
    "Submissions": {
      "allOf": [
        {
          "$ref": "ListEnvelope.schema.json"
        },
        {
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "SubmissionView.schema.json"
              }
            }
          }
        }
      ]
    },
    "Decisions": {
      "allOf": [
        {
          "$ref": "ListEnvelope.schema.json"
        },
        {
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "GateDecision.schema.json"
              }
            }
          }
        }
      ]
    },
    "Cases": {
      "allOf": [
        {
          "$ref": "ListEnvelope.schema.json"
        },
        {
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "FailureCase.schema.json"
              }
            }
          }
        }
      ]
    },
    "Results": {
      "allOf": [
        {
          "$ref": "ListEnvelope.schema.json"
        },
        {
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "https://openit.example/survey/v1/SessionResult.json"
              }
            }
          }
        }
      ]
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/Ids"
    },
    {
      "$ref": "#/$defs/ArtifactRefs"
    },
    {
      "$ref": "#/$defs/Reviews"
    },
    {
      "$ref": "#/$defs/Releases"
    },
    {
      "$ref": "#/$defs/Submissions"
    },
    {
      "$ref": "#/$defs/Decisions"
    },
    {
      "$ref": "#/$defs/Cases"
    },
    {
      "$ref": "#/$defs/Results"
    }
  ]
}
