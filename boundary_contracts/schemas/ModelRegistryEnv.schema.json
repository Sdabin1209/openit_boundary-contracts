{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://openit.example/schemas/ModelRegistryEnv.schema.json",
 "title": "ModelRegistryEnv",
 "description": "model-registry 서비스(model-lab 소유) 컨테이너의 환경 변수 선언 (3.2.0, U73: 영역 사이 설정 이름은 이 선언에만 있다. deploy 는 여기 있는 이름만 주고, 서비스는 기동 때 자기 environ 을 이 스키마로 검증한다. 접두사가 붙은 이름 중 여기 없는 것은 거부, 접두사 없는 다른 변수(PATH 등)는 보지 않는다.)",
 "x-producers": [
  "deploy"
 ],
 "x-consumers": [
  "model-lab"
 ],
 "type": "object",
 "$defs": {
  "Port": {
   "type": "string",
   "pattern": "^([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$(?![\\s\\S])",
   "description": "TCP 포트 1~65535"
  },
  "Int": {
   "type": "string",
   "pattern": "^[0-9]+$(?![\\s\\S])",
   "description": "0 이상 정수"
  },
  "PosInt": {
   "type": "string",
   "pattern": "^[1-9][0-9]*$(?![\\s\\S])",
   "description": "1 이상 정수"
  },
  "Seconds": {
   "type": "string",
   "pattern": "^[0-9]+(\\.[0-9]+)?$(?![\\s\\S])",
   "description": "초(소수 허용, 0 이상)"
  },
  "Flag1": {
   "type": "string",
   "enum": [
    "1"
   ],
   "description": "켜려면 정확히 '1'. 없음 = 꺼짐"
  },
  "Path": {
   "$ref": "_common.schema.json#/$defs/AbsolutePath"
  },
  "RoleTokenList": {
   "type": "string",
   "minLength": 1,
   "description": "'역할=토큰,역할=토큰'"
  },
  "CsvRoles": {
   "type": "string",
   "pattern": "^[a-z0-9-]+(,[a-z0-9-]+)*$(?![\\s\\S])",
   "description": "쉼표로 구분한 역할 이름 목록"
  }
 },
 "propertyNames": {
  "anyOf": [
   {
    "not": {
     "pattern": "^(MODEL_REGISTRY_)"
    }
   },
   {
    "enum": [
     "MODEL_REGISTRY_AUTH_FAIL_LIMIT",
     "MODEL_REGISTRY_HOST",
     "MODEL_REGISTRY_MAX_BODY",
     "MODEL_REGISTRY_MAX_CONNECTIONS",
     "MODEL_REGISTRY_MAX_PUBLISHES",
     "MODEL_REGISTRY_MIN_FREE_GB",
     "MODEL_REGISTRY_MIN_TOKEN_LEN",
     "MODEL_REGISTRY_PORT",
     "MODEL_REGISTRY_READ_TOKENS",
     "MODEL_REGISTRY_READ_TOKENS_FILE",
     "MODEL_REGISTRY_ROOT",
     "MODEL_REGISTRY_SHUTDOWN_GRACE",
     "MODEL_REGISTRY_SOCKET_TIMEOUT",
     "MODEL_REGISTRY_THREADS",
     "MODEL_REGISTRY_WRITE_TOKENS",
     "MODEL_REGISTRY_WRITE_TOKENS_FILE"
    ]
   }
  ]
 },
 "properties": {
  "MODEL_REGISTRY_READ_TOKENS_FILE": {
   "$ref": "#/$defs/Path",
   "description": "비밀(D84): 읽기 경로 토큰 목록(역할=토큰, 예: release-gate=...). 파일 경로"
  },
  "MODEL_REGISTRY_READ_TOKENS": {
   "$ref": "#/$defs/RoleTokenList",
   "description": "개발·시험 호환: 읽기 경로 토큰 목록(역할=토큰, 예: release-gate=...). 운영 금지(운영은 MODEL_REGISTRY_READ_TOKENS_FILE)"
  },
  "MODEL_REGISTRY_WRITE_TOKENS_FILE": {
   "$ref": "#/$defs/Path",
   "description": "비밀(D84): 게시(POST /v1/packages) 토큰. 역할은 model-lab 만. 파일 경로"
  },
  "MODEL_REGISTRY_WRITE_TOKENS": {
   "$ref": "#/$defs/RoleTokenList",
   "description": "개발·시험 호환: 게시(POST /v1/packages) 토큰. 역할은 model-lab 만. 운영 금지(운영은 MODEL_REGISTRY_WRITE_TOKENS_FILE)"
  },
  "MODEL_REGISTRY_ROOT": {
   "$ref": "#/$defs/Path",
   "description": "저장 볼륨",
   "default": "/data"
  },
  "MODEL_REGISTRY_HOST": {
   "type": "string",
   "minLength": 1,
   "description": "바인드 주소",
   "default": "0.0.0.0"
  },
  "MODEL_REGISTRY_PORT": {
   "$ref": "_common.schema.json#/$defs/BindPort",
   "description": "바인드 포트. 0이면 빈 포트",
   "default": "8080"
  },
  "MODEL_REGISTRY_MAX_BODY": {
   "$ref": "#/$defs/PosInt",
   "description": "게시 본문 최대 바이트. 근거 없음(측정 안 함)",
   "default": "4294967296"
  },
  "MODEL_REGISTRY_SOCKET_TIMEOUT": {
   "$ref": "#/$defs/Seconds",
   "description": "유휴 연결을 닫는 초(waitress channel_timeout, ML-1)",
   "default": "30"
  },
  "MODEL_REGISTRY_MAX_CONNECTIONS": {
   "$ref": "#/$defs/PosInt",
   "description": "동시 연결 상한(넘으면 backlog 대기, 503 아님) 근거: model-lab ADR 0023(waitress connection_limit), 측정 기록 없음",
   "default": "32"
  },
  "MODEL_REGISTRY_THREADS": {
   "$ref": "#/$defs/PosInt",
   "description": "작업 스레드 수(ADR 0023)",
   "default": "16"
  },
  "MODEL_REGISTRY_MAX_PUBLISHES": {
   "$ref": "#/$defs/PosInt",
   "description": "동시 게시 상한. 넘으면 503 근거: 기본값은 model-lab 가 정한 설계값(측정 기록 없음)",
   "default": "1"
  },
  "MODEL_REGISTRY_AUTH_FAIL_LIMIT": {
   "$ref": "#/$defs/PosInt",
   "description": "같은 주소의 인증 실패 상한(60초 창). 넘으면 잠시 503 근거: 기본값은 model-lab 가 정한 설계값(측정 기록 없음)",
   "default": "10"
  },
  "MODEL_REGISTRY_SHUTDOWN_GRACE": {
   "$ref": "#/$defs/Seconds",
   "description": "SIGTERM 뒤 진행 중 요청 대기 초(Docker 10초보다 짧게, 측정 안 함)",
   "default": "8"
  },
  "MODEL_REGISTRY_MIN_FREE_GB": {
   "$ref": "#/$defs/Seconds",
   "description": "게시 전 요구 여유 공간 GB(본문 2배 + 이 값, ML-2)",
   "default": "1"
  },
  "MODEL_REGISTRY_MIN_TOKEN_LEN": {
   "$ref": "#/$defs/PosInt",
   "description": "토큰 최소 길이"
  }
 },
 "anyOf": [
  {
   "required": [
    "MODEL_REGISTRY_READ_TOKENS_FILE"
   ]
  },
  {
   "required": [
    "MODEL_REGISTRY_READ_TOKENS"
   ]
  },
  {
   "required": [
    "MODEL_REGISTRY_WRITE_TOKENS_FILE"
   ]
  },
  {
   "required": [
    "MODEL_REGISTRY_WRITE_TOKENS"
   ]
  }
 ]
}
