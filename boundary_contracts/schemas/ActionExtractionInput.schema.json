{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActionExtractionInput",
  "description": "LoRA-A 입력(2.0.0, D74). 환자 발화 1턴과 직전 문맥. 모델이 받는 JSON 그대로이며 학습 데이터의 user 메시지 내용이다. 시스템 프롬프트는 별도(serving_config의 프롬프트 템플릿 버전).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question_id",
    "current_question",
    "user_utterance",
    "state"
  ],
  "properties": {
    "question_id": {
      "type": "string",
      "pattern": "^Q[0-9]+(\\.D[0-9]{2})?(_[0-9]+)?$",
      "description": "상담원이 지금 묻고 있는 문항. 정정·충돌 흐름에서는 값의 문항이 아니라 그때 묻던 문항이다."
    },
    "current_question": {
      "type": "string",
      "minLength": 1,
      "description": "상담원이 방금 한 말(앞 LoRA-B 응답 그대로 또는 문항 은행 질문)."
    },
    "user_utterance": {
      "type": "string",
      "minLength": 1,
      "description": "환자 말 1턴."
    },
    "state": {
      "type": "object",
      "description": "저장 값. 지금 문항(재질문 중인 칸 포함), 직전에 물은 문항, 참조 원천 문항. 첫 문항이면 비어 있다.",
      "propertyNames": {
        "pattern": "^Q[0-9]+(\\.D[0-9]{2})?(_[0-9]+)?(\\[(soju|beer|spirits|makgeolli|wine)\\])?\\.[a-z][a-z_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "status"
        ],
        "properties": {
          "value": {
            "$comment": "칸 값. 데이터에서 확인한 형태: 불리언, 숫자(정수·소수), 선택지 코드 문자열, null.",
            "type": [
              "boolean",
              "number",
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "ANSWERED",
              "CORRECTION",
              "MISSING",
              "UNCLEAR",
              "CONFLICT",
              "UNKNOWN",
              "REJECTED"
            ]
          }
        }
      }
    }
  }
}
