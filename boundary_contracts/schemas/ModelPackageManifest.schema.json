{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelPackageManifest",
  "description": "불변 모델 패키지(LoRA 어댑터 하나). 상태는 두지 않는다. 승인 여부는 GateDecision이 조합 단위로 기록한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pipeline_schema_version",
    "package_id",
    "version",
    "role",
    "created_at",
    "runtime_contract_version",
    "base_model",
    "adapter_hash",
    "serving_config",
    "serving_config_hash",
    "system_prompt",
    "lineage",
    "eval_report_ref",
    "content_hash"
  ],
  "properties": {
    "pipeline_schema_version": {
      "$ref": "_common.schema.json#/$defs/PipelineSchemaVersion"
    },
    "package_id": {
      "$ref": "_common.schema.json#/$defs/Id"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "LORA_A",
        "LORA_B"
      ]
    },
    "created_at": {
      "$ref": "_common.schema.json#/$defs/Timestamp"
    },
    "runtime_contract_version": {
      "$ref": "_common.schema.json#/$defs/RuntimeContractVersion"
    },
    "base_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "기반 모델 이름. 허브의 이름(예: 'Qwen/Qwen2.5-1.5B-Instruct')을 그대로 쓸 수 있도록 Id 패턴이 아니라 비어 있지 않은 문자열이다(1.2에서 넓힘)."
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "adapter_hash": {
      "$ref": "_common.schema.json#/$defs/Hash"
    },
    "serving_config": {
      "type": "object",
      "description": "추론 서버 설정. 형식은 model-runtime이 정하며 serving_config_hash로 고정한다"
    },
    "serving_config_hash": {
      "$ref": "_common.schema.json#/$defs/Hash"
    },
    "system_prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\\\\\x00]+$",
          "maxLength": 200,
          "description": "어댑터 디렉터리 안의 시스템 프롬프트 파일 경로(상대 경로, '/'로 구분, '..'·절대 경로·역슬래시 금지). 예: system_prompt.txt. 파일이 어댑터 디렉터리 안에 있으므로 adapter_hash에도 포함된다."
        },
        "sha256": {
          "$ref": "_common.schema.json#/$defs/Hash",
          "description": "그 파일 바이트의 해시(canonical.file_hash). 어댑터 하나(role 하나)에 프롬프트 하나가 짝이다."
        }
      },
      "description": "이 어댑터를 학습할 때 쓴 시스템 프롬프트(D75). model-runtime은 서빙할 때 이 패키지의 프롬프트만 쓴다. LoRA 교체(D72)가 프롬프트까지 함께 바뀌어야 하기 때문이다. serving_config의 프롬프트 템플릿 버전과는 별개다(INTERFACES.md I9)."
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "training_run_id",
        "turn_engine_version",
        "model_runtime_version"
      ],
      "properties": {
        "dataset": {
          "$ref": "_common.schema.json#/$defs/ArtifactRef"
        },
        "training_run_id": {
          "$ref": "_common.schema.json#/$defs/Id"
        },
        "turn_engine_version": {
          "$ref": "_common.schema.json#/$defs/LibraryVersion"
        },
        "model_runtime_version": {
          "$ref": "_common.schema.json#/$defs/LibraryVersion"
        },
        "question_sets": {
          "type": "array",
          "items": {
            "$ref": "_common.schema.json#/$defs/ArtifactRef"
          },
          "description": "학습에 쓴 문항 세트. 게이트의 QUESTION_MODEL_COMPAT가 참고하는 정보이며 반려 근거로 쓰지는 않는다(새 문항 세트는 재학습 없이 출고할 수 있다, D32)."
        }
      }
    },
    "eval_report_ref": {
      "$ref": "_common.schema.json#/$defs/Id"
    },
    "content_hash": {
      "$ref": "_common.schema.json#/$defs/Hash"
    },
    "ext": {
      "type": "object",
      "description": "영역이 계약을 바꾸지 않고 덧붙이는 부가 정보. 키는 영역 이름(예: 'model-lab')이고 값은 그 영역이 정한다. 다른 영역은 이해하지 못해도 보존하고 전달해야 하며, 판단에 쓰지 않는다. 여러 영역이 필요로 하게 되면 정식 필드로 올린다."
    }
  }
}
