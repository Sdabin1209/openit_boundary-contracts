{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SyntheticJobConfigRun.schema.json",
  "title": "SyntheticJobConfigRun",
  "description": "`python -m synthetic_data run --config <파일>`의 설정. 만드는 쪽: deploy(E2E 설정 sd_config) 또는 개발자. 읽는 쪽: synthetic-data(run_plan.py 가 이 스키마로 먼저 검증한다). 모르는 키 정책: 최상위와 중첩 객체 모두 거부(additionalProperties false, ADR 0014). 이력: CR-008(2026-10-29)에서 계약으로 올렸다. 3.7.0(D9): adapters 는 역할별 HttpClientSettings 다(그 전의 factory 'module:function' 문자열은 설정이 영역 내부 모듈 경로를 알게 했고 시험 대역 주입 칸이 됐다).",
  "x-producers": [
    "deploy"
  ],
  "x-consumers": [
    "synthetic-data"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id",
    "seed",
    "survey_schema_dir",
    "adapters",
    "question_sets",
    "split",
    "output"
  ],
  "properties": {
    "_comment": {
      "type": "string"
    },
    "dataset_id": {
      "$ref": "_common.schema.json#/$defs/Id"
    },
    "seed": {
      "type": "integer",
      "description": "같은 입력과 시드는 같은 결과(멱등). bool은 거부."
    },
    "created_at": {
      "$ref": "_common.schema.json#/$defs/Timestamp",
      "description": "매니페스트 created_at(UTC Z). 생략하면 실행 시각. --created-at 인자가 우선. 코드는 형식을 검사하지 않고 DatasetManifest 게시 때 검증된다."
    },
    "version": {
      "type": "string",
      "description": "생략하면 digest에서 만든다(v + digest 앞 32자리, 128비트, 2026-10-29 ADR 0006 보강). 문자 규칙은 _common Id.",
      "allOf": [
        {
          "$ref": "_common.schema.json#/$defs/Id"
        }
      ]
    },
    "action_rules_version": {
      "type": [
        "string",
        "null"
      ],
      "description": "계약 ActionExtractionRules.rules_version(LoRA-A 출력 규칙의 세대). 3.0.0에서 turn_engine_version을 대체(D109): 규칙의 정본은 계약 데이터다."
    },
    "survey_schema_dir": {
      "type": "string",
      "minLength": 1,
      "description": "문진 스키마 디렉터리. 상대 경로는 설정 파일 위치 기준. SD-07은 이 CR 범위 밖."
    },
    "adapters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_reader"
      ],
      "properties": {
        "question_reader": {
          "$ref": "_common.schema.json#/$defs/HttpClientSettings",
          "description": "문항 세트 읽기(question-authoring I1 HTTP, 계약 클라이언트 QuestionReader)"
        },
        "failure_store": {
          "$ref": "_common.schema.json#/$defs/HttpClientSettings",
          "description": "확정 실패 사례 읽기(ops-feedback I7 HTTP, 계약 클라이언트 FailureStore). seeds.enabled 이면 필요"
        }
      }
    },
    "question_sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string"
          },
          "usage": {
            "enum": [
              "TRAIN_POOL",
              "HELD_OUT_EVAL"
            ],
            "default": "TRAIN_POOL"
          }
        }
      },
      "description": "불변식(코드가 검사, 스키마로는 표현 못 함): 같은 id를 TRAIN_POOL과 HELD_OUT_EVAL에 함께 쓰지 않는다."
    },
    "reviewed_only": {
      "type": "boolean",
      "default": true
    },
    "seeds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "question_set_id": {
          "type": "string"
        },
        "max_pii_suspect_rows": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "시드의 입력·정답에서 개인정보 의심 패턴이 있는 사례 수의 허용치. 생략하면 0(하나라도 있으면 실행 거부), null이면 경고만(ADR 0005 보강)."
        }
      },
      "description": "불변식(코드가 검사): enabled=true이면 adapters.failure_store가 있어야 하고, question_set_id는 question_sets에 있어야 한다."
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ratios"
      ],
      "properties": {
        "ratios": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "TRAIN",
            "VALIDATION",
            "EVAL"
          ],
          "properties": {
            "TRAIN": {
              "type": "number",
              "minimum": 0
            },
            "VALIDATION": {
              "type": "number",
              "minimum": 0
            },
            "EVAL": {
              "type": "number",
              "minimum": 0
            }
          },
          "description": "합이 0보다 커야 한다(코드가 검사). 값은 사용자 결정(O11)이며 예시 값은 동작 확인용 자리 표시."
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "per_kind": {
          "type": "integer",
          "default": 2,
          "minimum": 0
        }
      }
    },
    "regeneration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "full",
            "affected_only"
          ],
          "default": "full"
        }
      }
    },
    "output": {
      "$ref": "SyntheticDefs.schema.json#/$defs/Output"
    }
  },
  "$defs": {}
}
