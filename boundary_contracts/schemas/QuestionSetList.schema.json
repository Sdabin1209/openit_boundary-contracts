{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuestionSetList",
  "description": "3.4.18: GET /v1/question-sets(공개 API) 응답. 활성 릴리스의 문진표 전부(PUBLIC_API.md 24행). 1개 이상이다.",
  "x-producers": [
    "survey-service"
  ],
  "x-consumers": [
    "kiosk-frontend"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_set_id",
          "title",
          "version"
        ],
        "properties": {
          "question_set_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])",
            "maxLength": 128
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
