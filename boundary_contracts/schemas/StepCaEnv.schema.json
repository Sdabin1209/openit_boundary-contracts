{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://openit.example/schemas/StepCaEnv.schema.json",
 "title": "StepCaEnv",
 "description": "3.4.10(구조 규칙 6: deploy → platform 입력을 계약에 둔다, 헤드 누락 수정). platform 인증서 발급 이미지(step-ca) 컨테이너의 입력. 부명령은 첫 인자(x-argv): serve(인증기관), root(루트 내보내기), token <이름>...(발급 토큰), cert <이름>(서비스 인증서 발급·갱신, R3.11·R4.6).",
 "x-producers": [
  "deploy"
 ],
 "x-consumers": [
  "platform"
 ],
 "type": "object",
 "$defs": {
  "Port": {
   "type": "string",
   "pattern": "^([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
   "description": "TCP 포트 1~65535"
  },
  "PosInt": {
   "type": "string",
   "pattern": "^[1-9][0-9]*$",
   "description": "1 이상 정수"
  },
  "Path": {
   "type": "string",
   "pattern": "^/",
   "minLength": 1,
   "description": "컨테이너 안 절대 경로"
  },
  "Duration": {
   "type": "string",
   "pattern": "^[0-9]+(ms|s|m|h|d)$",
   "description": "기간(정수+단위 ms|s|m|h|d)"
  },
  "HostPort": {
   "type": "string",
   "pattern": "^[A-Za-z0-9.-]+:[0-9]{1,5}$",
   "description": "<호스트>:<포트>"
  },
  "HttpsUrl": {
   "type": "string",
   "pattern": "^https://[^\\s]+$",
   "description": "https URL"
  }
 },
 "propertyNames": {
  "anyOf": [
   {
    "not": {
     "pattern": "^(STEP_|PKI_OUT)"
    }
   },
   {
    "enum": [
     "PKI_OUT",
     "STEP_CA_DNS_NAMES",
     "STEP_CA_PASSWORD_FILE",
     "STEP_CA_PORT",
     "STEP_CA_URL",
     "STEP_CERT_NOT_AFTER",
     "STEP_RENEW_EXPIRES_IN"
    ]
   }
  ]
 },
 "properties": {
  "STEP_CA_PORT": {
   "$ref": "#/$defs/Port",
   "description": "serve 의 포트",
   "default": "9000"
  },
  "STEP_CA_DNS_NAMES": {
   "type": "string",
   "pattern": "^$|^[A-Za-z0-9.-]+( [A-Za-z0-9.-]+)*$",
   "description": "serve 의 추가 DNS 이름(공백 구분). 없으면 step-ca"
  },
  "STEP_CA_PASSWORD_FILE": {
   "$ref": "#/$defs/Path",
   "description": "인증기관 키 암호 파일(비밀, D84). serve·token",
   "default": "/run/secrets/step-ca-password"
  },
  "STEP_CA_URL": {
   "$ref": "#/$defs/HttpsUrl",
   "description": "token·cert 가 부를 인증기관 주소",
   "default": "https://step-ca:9000"
  },
  "PKI_OUT": {
   "$ref": "#/$defs/Path",
   "description": "root 가 루트 인증서(root_ca.crt)를 쓸 폴더",
   "default": "/out"
  },
  "STEP_CERT_NOT_AFTER": {
   "$ref": "#/$defs/Duration",
   "description": "cert 가 받는 인증서 유효 기간. platform ADR 0012"
  },
  "STEP_RENEW_EXPIRES_IN": {
   "$ref": "#/$defs/Duration",
   "description": "cert 가 만료 전 갱신을 시작하는 남은 기간. platform ADR 0012",
   "default": "12h"
  }
 },
 "x-argv": {
  "enum": [
   "serve",
   "root",
   "token",
   "cert"
  ],
  "description": "컨테이너 첫 인자. token·cert 는 뒤에 서비스 이름"
 }
}
