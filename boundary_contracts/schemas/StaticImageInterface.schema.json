{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "StaticImageInterface.schema.json",
  "title": "StaticImageInterface",
  "description": "kiosk-frontend 이미지가 deploy(게이트웨이)에 약속하는 배포 인터페이스의 기계 판독 선언. 쓰는 쪽: kiosk-frontend(예시는 Dockerfile·server/static.mjs·CR-001에서 가져옴). 읽는 쪽: deploy. 초안: 지금은 문서(CR-001)와 코드에만 있고 계약에 없다.",
  "type": "object",
  "required": [
    "port",
    "env",
    "routes",
    "not_served_prefixes",
    "user"
  ],
  "properties": {
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "description": "컨테이너가 듣는 포트. 기본 8080. PORT가 정수가 아니면 시작을 거부한다(종료 코드 2)."
    },
    "env": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "PORT",
          "STATIC_DIR",
          "CONFIG_FILE"
        ]
      },
      "additionalProperties": {
        "type": "string"
      },
      "description": "이미지가 읽는 환경 변수와 기본값(CONFIG_FILE은 기본 없음 = 키를 두지 않는다). 비밀은 환경 변수로 받지 않는다."
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "kind": {
            "enum": [
              "page",
              "asset",
              "health",
              "ready",
              "device_config"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "path": {
                "const": "/healthz"
              }
            },
            "required": [
              "path"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "path": {
                "const": "/readyz"
              }
            },
            "required": [
              "path"
            ]
          }
        }
      ],
      "description": "이미지가 직접 내는 경로. /healthz, /readyz는 반드시 있다."
    },
    "not_served_prefixes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/.*/$"
      },
      "contains": {
        "const": "/v1/"
      },
      "description": "이 이미지가 처리하지 않는 접두어. /v1/은 게이트웨이가 문진 서비스로 프록시한다(SSE 응답 버퍼링 끔, Last-Event-ID 전달은 deploy 몫)."
    },
    "user": {
      "type": "string",
      "not": {
        "enum": [
          "root",
          "0"
        ]
      },
      "description": "실행 사용자. root(또는 uid 0)가 아니다."
    },
    "device_config_schema": {
      "type": "string",
      "const": "DeviceConfig.schema.json"
    }
  },
  "additionalProperties": false
}
