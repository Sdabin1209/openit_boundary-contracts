{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PublicApiRequests.schema.json",
  "title": "PublicApiRequests",
  "description": "survey-service 공개 API(PUBLIC_API.md) 요청 본문 묶음(호출별 $defs). 생산자(kiosk-frontend, admin-console, 설치처 연동)는 각 본문의 정본 계약(예: PushSubscriptionRequest, StaffCallRetryRequest)으로 보내기 전에 검증하고, 서버는 openit_link 계약 모드가 openapi/survey-service.json 을 통해 이 $defs 로 검증한다. 4.0.0: SessionStartBody 의 session_id(클라이언트가 정해 보내는 방식, 3.0.0 제거 예고)를 없앴다 — 세션 ID 는 서버가 발급한다(D106).",
  "x-producers": [
    "kiosk-frontend",
    "admin-console",
    "external:install-site"
  ],
  "x-consumers": [
    "survey-service"
  ],
  "$defs": {
    "SessionStartBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "SESSION_START"
        },
        "turn_id": {
          "$ref": "_common.schema.json#/$defs/Id",
          "description": "새 세션의 첫 턴 ID로 기록한다. 예약 값 start·end·idle-expire도 허용. 세션 시작은 멱등이 아니며 이 값으로 재전송을 판별하지 않는다(PUBLIC_API 세션 시작, 4.0.1)"
        },
        "subject_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:/#=+-]{1,128}$(?![\\s\\S])",
          "description": "병원이 정한 불투명 환자·방문 참조"
        },
        "question_set_id": {
          "$ref": "_common.schema.json#/$defs/Id",
          "description": "문진할 문진표 ID(FrontendMessage SESSION_START와 같다). 활성 문진표가 하나면 생략할 수 있고 둘 이상이면 필수(검사는 서비스)."
        }
      }
    },
    "UtteranceBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "kind",
        "utterance",
        "turn_id"
      ],
      "properties": {
        "session_id": {
          "$ref": "_common.schema.json#/$defs/SessionId"
        },
        "kind": {
          "const": "UTTERANCE"
        },
        "turn_id": {
          "$ref": "_common.schema.json#/$defs/Id",
          "not": {
            "enum": [
              "start",
              "end",
              "idle-expire"
            ]
          }
        },
        "utterance": {
          "type": "string",
          "maxLength": 1000,
          "pattern": "\\S",
          "description": "공백만으로 이뤄지면 거부한다(strip 뒤 빈 문자열) 근거: 상한 1000 은 문진 스키마 UtteranceBody 상한과 같다(PUBLIC_API.md)"
        }
      }
    },
    "SessionEndBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "kind"
      ],
      "properties": {
        "session_id": {
          "$ref": "_common.schema.json#/$defs/SessionId"
        },
        "kind": {
          "const": "SESSION_END"
        },
        "turn_id": {
          "$ref": "_common.schema.json#/$defs/Id",
          "description": "예약 값 허용"
        }
      }
    },
    "InterventionBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "decision",
        "turn_id"
      ],
      "properties": {
        "session_id": {
          "$ref": "_common.schema.json#/$defs/SessionId"
        },
        "decision": {
          "enum": [
            "RESUME",
            "END"
          ]
        },
        "turn_id": {
          "$ref": "_common.schema.json#/$defs/Id",
          "not": {
            "enum": [
              "start",
              "end",
              "idle-expire"
            ]
          }
        },
        "staff_id": {
          "description": "무시된다"
        }
      }
    },
    "StaffCallRetryBody": {
      "allOf": [
        {
          "$ref": "StaffCallRetryRequest.schema.json"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "turn_id"
          ],
          "properties": {
            "turn_id": {
              "$ref": "_common.schema.json#/$defs/Id",
              "not": {
                "enum": [
                  "start",
                  "end",
                  "idle-expire"
                ]
              }
            }
          }
        }
      ]
    },
    "StaffCallReportBody": {
      "allOf": [
        {
          "$ref": "StaffCallReport.schema.json"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome",
            "turn_id"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "STAFF_NOTIFIED_MANUALLY",
                "NOT_NOTIFIED"
              ]
            },
            "turn_id": {
              "$ref": "_common.schema.json#/$defs/Id",
              "not": {
                "enum": [
                  "start",
                  "end",
                  "idle-expire"
                ]
              }
            }
          }
        }
      ]
    },
    "PushSubscribeBody": {
      "$ref": "PushSubscriptionRequest.schema.json",
      "description": "POST /v1/staff/push-subscriptions 본문. 정본은 계약 PushSubscriptionRequest(3.7.0에서 하나로 합침)"
    },
    "PushUnsubscribeBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint"
      ],
      "properties": {
        "endpoint": {
          "$ref": "PushSubscriptionRequest.schema.json#/properties/endpoint",
          "description": "해지할 구독의 endpoint(등록 때와 같은 규칙)"
        }
      }
    },
    "RiskSignalBody": {
      "$ref": "https://openit.example/survey/v1/RiskSignal.json"
    },
    "ResultAckBody": {
      "type": "object",
      "maxProperties": 0,
      "description": "POST /v1/results/{session_id}/ack 본문: 빈 객체 {} (PUBLIC_API.md 82행). 확인한 계정·시각은 서버가 게이트웨이 머리글과 시계로 정한다"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/SessionStartBody"
    },
    {
      "$ref": "#/$defs/UtteranceBody"
    },
    {
      "$ref": "#/$defs/SessionEndBody"
    },
    {
      "$ref": "#/$defs/InterventionBody"
    },
    {
      "$ref": "#/$defs/StaffCallRetryBody"
    },
    {
      "$ref": "#/$defs/StaffCallReportBody"
    },
    {
      "$ref": "#/$defs/PushSubscribeBody"
    },
    {
      "$ref": "#/$defs/PushUnsubscribeBody"
    },
    {
      "$ref": "#/$defs/RiskSignalBody"
    }
  ]
}
