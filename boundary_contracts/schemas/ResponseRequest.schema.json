{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResponseRequest",
  "description": "LoRA-B 입력(2.0.0, D74). A 출력을 받은 서비스가 표 찾기(문항 번호로 질문 문장, 칸으로 사람 말 설명)만으로 조립한다. 모델 호출 없음, 판단 없음. 시작(START)은 A를 거치지 않고 서비스가 직접 만든다. 출력은 JSON이 아니라 응답 문장 텍스트(ResponseText).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "topic",
    "next"
  ],
  "properties": {
    "action": {
      "enum": [
        "START",
        "NEXT",
        "CORRECT",
        "REASK",
        "CONFIRM",
        "HOLD",
        "SKIP",
        "REDIRECT"
      ]
    },
    "reason": {
      "enum": [
        "MISSING",
        "OUT_OF_RANGE",
        "UNKNOWN_UNIT",
        "VAGUE_QUANTITY",
        "RANGE_SPANS_OPTIONS",
        "COUNT_EXCEEDS_DAYS",
        "OTHER_BEVERAGE",
        "BEVERAGE_MISSING",
        "MISSING_NUMBER",
        "UNPARSED_VALUE",
        "INVALID_OPTION",
        "CONFLICT_WITH_PREVIOUS",
        "CONFLICT_DOES_NOT_DRINK",
        "CONFLICT_MAX_BELOW_USUAL",
        "UNCERTAIN",
        "REQUEST_SKIP",
        "REFUSED",
        "ASK_PURPOSE",
        "OFF_TOPIC",
        "OUT_OF_SCHEMA"
      ]
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "description": "지금 다루는 문항을 사람 말로(START는 첫 문항). IO_SPEC 본문에는 없고 데이터에 있다."
    },
    "user_utterance": {
      "type": "string",
      "minLength": 1,
      "description": "환자 말. START에는 없다."
    },
    "known": {
      "type": "string",
      "description": "되짚을 수 있는 값을 사람 말로. 값이 없으면 빈 문자열(CONFIRM은 항상 빈 문자열). START에는 없다."
    },
    "ask": {
      "type": "string",
      "minLength": 1,
      "description": "REASK·CONFIRM에서 다시 물을 것."
    },
    "previous": {
      "type": "string",
      "minLength": 1,
      "description": "CONFIRM의 이전 값(사람 말)."
    },
    "current": {
      "type": "string",
      "minLength": 1,
      "description": "CONFIRM의 이번 값(사람 말)."
    },
    "hold": {
      "type": "string",
      "minLength": 1,
      "description": "HOLD·SKIP에서 비워 두는 부분의 짧은 이름."
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "description": "REDIRECT OUT_OF_SCHEMA의 요약(A 출력 note 그대로)."
    },
    "next": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "question_id",
            "text"
          ],
          "properties": {
            "type": {
              "enum": [
                "NEXT",
                "SAME"
              ]
            },
            "question_id": {
              "type": "string",
              "pattern": "^Q[0-9]+(\\.D[0-9]{2})?(_[0-9]+)?$"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "END"
            }
          }
        }
      ],
      "description": "type: NEXT(다음 문항) / SAME(같은 문항 다시) / END(마무리, type만). text는 문항 은행의 질문 문장."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "START"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "action",
          "topic",
          "next"
        ],
        "properties": {
          "reason": false,
          "user_utterance": false,
          "known": false,
          "ask": false,
          "previous": false,
          "current": false,
          "hold": false,
          "note": false,
          "next": {
            "properties": {
              "type": {
                "const": "NEXT"
              },
              "question_id": {
                "const": "Q1.D01"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "NEXT"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "action",
          "topic",
          "user_utterance",
          "known",
          "next"
        ],
        "properties": {
          "reason": false,
          "ask": false,
          "previous": false,
          "current": false,
          "hold": false,
          "note": false,
          "next": {
            "properties": {
              "type": {
                "enum": [
                  "NEXT",
                  "END"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "CORRECT"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "action",
          "topic",
          "user_utterance",
          "known",
          "next"
        ],
        "properties": {
          "reason": false,
          "ask": false,
          "previous": false,
          "current": false,
          "hold": false,
          "note": false,
          "next": {
            "properties": {
              "type": {
                "enum": [
                  "NEXT",
                  "END"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "REASK"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "action",
          "topic",
          "user_utterance",
          "known",
          "next",
          "reason",
          "ask"
        ],
        "properties": {
          "previous": false,
          "current": false,
          "hold": false,
          "note": false,
          "next": {
            "properties": {
              "type": {
                "enum": [
                  "SAME"
                ]
              }
            }
          },
          "reason": {
            "enum": [
              "MISSING",
              "OUT_OF_RANGE",
              "UNKNOWN_UNIT",
              "VAGUE_QUANTITY",
              "RANGE_SPANS_OPTIONS",
              "COUNT_EXCEEDS_DAYS",
              "OTHER_BEVERAGE",
              "BEVERAGE_MISSING",
              "MISSING_NUMBER",
              "UNPARSED_VALUE",
              "INVALID_OPTION"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "CONFIRM"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "action",
          "topic",
          "user_utterance",
          "known",
          "next",
          "reason",
          "ask",
          "previous",
          "current"
        ],
        "properties": {
          "hold": false,
          "note": false,
          "next": {
            "properties": {
              "type": {
                "enum": [
                  "SAME"
                ]
              }
            }
          },
          "reason": {
            "enum": [
              "CONFLICT_WITH_PREVIOUS",
              "CONFLICT_DOES_NOT_DRINK",
              "CONFLICT_MAX_BELOW_USUAL"
            ]
          },
          "known": {
            "const": ""
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "HOLD"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "action",
          "topic",
          "user_utterance",
          "known",
          "next",
          "reason",
          "hold"
        ],
        "properties": {
          "ask": false,
          "previous": false,
          "current": false,
          "note": false,
          "next": {
            "properties": {
              "type": {
                "enum": [
                  "NEXT",
                  "END"
                ]
              }
            }
          },
          "reason": {
            "enum": [
              "UNCERTAIN"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "SKIP"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "action",
          "topic",
          "user_utterance",
          "known",
          "next",
          "reason",
          "hold"
        ],
        "properties": {
          "ask": false,
          "previous": false,
          "current": false,
          "note": false,
          "next": {
            "properties": {
              "type": {
                "enum": [
                  "NEXT",
                  "END"
                ]
              }
            }
          },
          "reason": {
            "enum": [
              "REQUEST_SKIP",
              "REFUSED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "REDIRECT"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "action",
          "topic",
          "user_utterance",
          "known",
          "next",
          "reason"
        ],
        "properties": {
          "ask": false,
          "previous": false,
          "current": false,
          "hold": false,
          "next": {
            "properties": {
              "type": {
                "enum": [
                  "SAME"
                ]
              }
            }
          },
          "reason": {
            "enum": [
              "ASK_PURPOSE",
              "OFF_TOPIC",
              "OUT_OF_SCHEMA"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason": {
            "const": "OUT_OF_SCHEMA"
          }
        },
        "required": [
          "reason"
        ]
      },
      "then": {
        "required": [
          "note"
        ]
      },
      "else": {
        "properties": {
          "note": false
        }
      }
    }
  ]
}
