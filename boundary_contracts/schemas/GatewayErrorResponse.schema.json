{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "GatewayErrorResponse.schema.json",
  "title": "GatewayErrorResponse",
  "description": "상류가 응답하지 않거나 시간을 넘겼을 때 게이트웨이가 만드는 정규화된 HTTP 응답(RUNTIME R3.2·R3.3). 헤더 이름은 소문자로 정규화한다. 앱이 낸 응답은 그대로 전달하며 이 봉투를 쓰지 않는다.",
  "x-producers": [
    "platform"
  ],
  "x-consumers": [
    "*"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "headers",
    "body"
  ],
  "properties": {
    "status": {
      "type": "integer",
      "enum": [
        503,
        504
      ]
    },
    "headers": {
      "type": "object",
      "required": [
        "retry-after"
      ],
      "properties": {
        "retry-after": {
          "type": "string",
          "const": "5"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "body": {
      "$ref": "GatewayError.schema.json"
    }
  }
}
