{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "GatewayErrorResponse.schema.json",
  "title": "GatewayErrorResponse",
  "description": "Normalized HTTP response generated by a gateway for an unavailable or timed-out upstream (R3.2/R3.3). Header names are normalized to lowercase. Application responses are preserved and do not use this envelope.",
  "x-producers": [
    "platform"
  ],
  "x-consumers": [
    "*"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "headers",
    "body"
  ],
  "properties": {
    "status": {
      "type": "integer",
      "enum": [
        503,
        504
      ]
    },
    "headers": {
      "type": "object",
      "required": [
        "retry-after"
      ],
      "properties": {
        "retry-after": {
          "type": "string",
          "const": "5"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "body": {
      "$ref": "GatewayError.schema.json"
    }
  }
}
