{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "RuntimeProfile.schema.json",
 "title": "RuntimeProfile",
 "description": "하드웨어별 서빙 프로파일(profiles/*.json, MODEL_RUNTIME_PROFILE). 파일은 model-runtime 이 이미지에 담아 내고(/app/profiles), deploy 는 MODEL_RUNTIME_PROFILE 로 어느 파일을 쓸지만 고르며, model-runtime(vLLM 백엔드)이 읽는다(4.0.0: 생산자를 실제와 맞췄다). 알려진 키만 허용하고 모르는 키는 거부한다: 지금 코드(load_profile)는 engine의 모르는 키는 거부하지만 최상위의 모르는 키는 주석으로 무시한다. 오타가 조용히 무시되지 않도록 최상위도 닫는 것이 제안이며 코드보다 엄격하다. 주석은 `_`로 시작하는 키로 쓴다(현재 파일의 `_comment`).",
 "x-producers": [
  "model-runtime"
 ],
 "x-consumers": [
  "model-runtime"
 ],
 "type": "object",
 "additionalProperties": false,
 "patternProperties": {
  "^_": {}
 },
 "properties": {
  "status": {
   "type": "object",
   "description": "측정 상태 기록(loadable, two_adapters_loaded_together, for, note). 서버는 읽지 않는 사람용 기록.",
   "additionalProperties": {
    "type": "string"
   }
  },
  "base_model": {
   "type": "string",
   "minLength": 1
  },
  "engine": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "dtype": {
     "type": "string",
     "minLength": 1
    },
    "max_model_len": {
     "type": "integer",
     "minimum": 1
    },
    "gpu_memory_utilization": {
     "type": "number",
     "exclusiveMinimum": 0,
     "maximum": 1,
     "description": "근거: 비율 0~1(vLLM gpu_memory_utilization 정의)"
    },
    "max_num_seqs": {
     "type": "integer",
     "minimum": 1
    },
    "max_loras": {
     "type": "integer",
     "minimum": 1
    },
    "max_lora_rank": {
     "type": "integer",
     "minimum": 1
    },
    "enforce_eager": {
     "type": "boolean"
    },
    "quantization": {
     "type": "string",
     "minLength": 1
    },
    "guided_decoding_backend": {
     "type": "string",
     "minLength": 1
    },
    "structured_outputs_backend": {
     "type": "string",
     "minLength": 1
    },
    "disable_log_stats": {
     "type": "boolean"
    },
    "tensor_parallel_size": {
     "type": "integer",
     "minimum": 1
    },
    "enable_prefix_caching": {
     "type": "boolean",
     "description": "vLLM 접두사(KV) 캐시. 3.2.0(CR-007, model-runtime): 릴리스 동안 시스템 프롬프트가 고정이라 재사용되므로 프로파일에 명시한다(vLLM 기본값에 맡기지 않는다). 측정 전"
    }
   }
  },
  "env": {
   "type": "object",
   "description": "엔진용 환경 변수. 값은 문자열. `_`로 시작하는 키는 주석이라 서버가 환경에 쓰지 않는다.",
   "patternProperties": {
    "^_": {
     "type": "string"
    },
    "^[A-Z][A-Z0-9_]*$(?![\\s\\S])": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "probe": {
   "type": "object",
   "description": "GPU 점검 스크립트(scripts/gpu_probe.py)용 중립 어댑터 생성 설정. 서버는 읽지 않는다.",
   "additionalProperties": false,
   "properties": {
    "tiny_lora_rank": {
     "type": "integer",
     "minimum": 1
    },
    "tiny_lora_targets": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     },
     "minItems": 1
    }
   }
  }
 }
}
