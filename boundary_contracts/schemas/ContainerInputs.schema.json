{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openit.example/schemas/ContainerInputs.schema.json",
  "title": "ContainerInputs",
  "description": "3.5.0(2026-11-06): 영역 이미지가 컨테이너 밖(배치 영역)에서 주입받아야 하는 것 전부. 이미지를 만드는 영역이 선언하고(라벨 io.openit.inputs), 띄우는 영역(deploy)은 이 선언과 정확히 같게 주입한다. 환경 변수의 이름·값은 env_schema 가 가리키는 계약 Env 가 정한다. 이 선언에 없는 주입(파일·쓰기 마운트·권한)은 하지 않고, 선언된 것은 빠뜨리지 않는다. 왜: 파일 권한·쓰기 경로·실행 사용자·argv 가 문장 규칙(CLAUDE.md '이미지는 다음을 지킨다')뿐이라 두 영역이 각자 해석했고, 2026-11-06 E2E 기동 실패 네 건(DB 비밀 읽기, TLS 사본 경로, 잡 argv, 토큰 이름)이 모두 그 어긋남이었다.",
  "x-producers": [
    "*"
  ],
  "x-consumers": [
    "deploy"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "image",
    "read_only_root",
    "exec_absolute_argv",
    "role_env",
    "roles",
    "jobs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "image": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "게시 이미지 이름(라벨 io.openit.service 와 같다)"
    },
    "read_only_root": {
      "const": true,
      "description": "루트 파일 시스템은 읽기 전용으로 띄운다. 쓰기는 roles.*.writable 에 선언한 경로만"
    },
    "exec_absolute_argv": {
      "const": true,
      "description": "명령의 첫 인자가 절대 경로면 이미지 진입점은 서버 준비 없이 그 argv 를 그대로 실행한다(잡 선언 JobsDeclaration.argv 의 실행 규칙, Docker 표준 진입점 관례)"
    },
    "role_env": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "description": "역할을 고르는 환경 변수 이름(예: STEP_ROLE). 역할이 하나면 null 이고 roles 의 키는 default 하나다"
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/InputSet"
      }
    },
    "jobs": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/InputSet"
      },
      "description": "잡마다(키 = 이 이미지 라벨 io.openit.jobs 의 잡 이름, argv 로 고른다) 그 잡 컨테이너가 받는 것. 잡이 없으면 빈 객체"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "role_env": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "roles": {
            "required": [
              "default"
            ],
            "maxProperties": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "Process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid",
        "gid"
      ],
      "description": "주입된 파일을 읽고 선언된 경로에 쓰는 프로세스의 숫자 사용자·그룹. 이름(app, postgres)이 아니라 숫자다: 배치 영역은 이미지 안의 /etc/passwd 를 모른다(구조 규칙 1)",
      "properties": {
        "uid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "gid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "File": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "required",
        "opened_by"
      ],
      "properties": {
        "path_env": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "description": "경로를 주는 환경 변수(예: DB_PASSWORD_FILE). null 이면 path 고정"
        },
        "path": {
          "type": "string",
          "pattern": "^/[^\\s]*$",
          "description": "path_env 가 없을 때 이미지가 읽는 경로(path_env 가 있으면 그 기본값)"
        },
        "directory": {
          "type": "boolean",
          "default": false,
          "description": "참이면 폴더(그 안의 파일 전부를 읽는다)"
        },
        "kind": {
          "enum": [
            "secret",
            "config",
            "certificate",
            "ca-bundle",
            "declaration"
          ],
          "description": "secret 은 값이 비밀이다(D84): 배치 영역은 다른 사용자가 읽지 못하게 주되 read_by 는 읽을 수 있어야 한다"
        },
        "schema": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][A-Za-z0-9]*$",
          "description": "내용이 따르는 계약 스키마 이름(있으면)"
        },
        "required": {
          "type": "boolean"
        },
        "opened_by": {
          "const": "start-process",
          "description": "주입된 파일은 컨테이너의 시작 프로세스(process 의 uid, 배치 영역이 붙인 보조 그룹 포함)가 연다. 배치 영역은 파일을 0640·그룹 SECRETS_GID 로 두고 그 그룹을 보조 그룹으로 붙인다. 사용자를 바꾼(gosu·setpriv) 뒤에는 보조 그룹이 사라지므로 그 전에 열거나 시작 프로세스가 자기 사본을 만들어 넘긴다(2026-11-06 DB 비밀 읽기 실패의 원인)"
        }
      }
    },
    "Writable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "persist",
        "written_by"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/[^\\s]*$"
        },
        "persist": {
          "type": "boolean",
          "description": "참이면 다시 시작해도 남아야 한다(이름 있는 볼륨). 거짓이면 tmpfs 로 충분하다"
        },
        "written_by": {
          "$ref": "#/$defs/Process",
          "description": "이 경로에 쓰는 프로세스. 배치 영역은 이 사용자가 쓸 수 있게 준다(tmpfs uid/gid/mode 또는 볼륨 소유)"
        }
      }
    },
    "InputSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "env_schema",
        "process",
        "files",
        "writable",
        "capabilities",
        "sysctls"
      ],
      "properties": {
        "env_schema": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*Env$",
          "description": "이 역할이 받는 환경 변수의 계약 스키마 이름"
        },
        "process": {
          "$ref": "#/$defs/Process",
          "description": "컨테이너가 시작하는 사용자(이미지 USER 의 숫자). 배치 영역은 user 를 덮어쓰지 않는다"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/File"
          }
        },
        "writable": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Writable"
          }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "NET_BIND_SERVICE",
              "CHOWN",
              "SETUID",
              "SETGID",
              "DAC_OVERRIDE",
              "FOWNER",
              "KILL"
            ]
          },
          "description": "cap_drop ALL 뒤에 더해야 하는 것만. 비어 있으면 더하지 않는다"
        },
        "sysctls": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "net.ipv4.ip_unprivileged_port_start"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "description": "배치 영역이 이 값으로 줘야 하는 커널 매개변수(이름 공간 안). 없으면 주지 않는다. 예: root 가 아닌 사용자가 1024 아래 포트를 열 때 net.ipv4.ip_unprivileged_port_start=0"
        }
      }
    }
  },
  "examples": [
    {
      "schema_version": 1,
      "image": "survey-service",
      "read_only_root": true,
      "exec_absolute_argv": true,
      "role_env": null,
      "roles": {
        "default": {
          "env_schema": "SurveyServiceEnv",
          "process": {
            "uid": 10001,
            "gid": 10001
          },
          "capabilities": [],
          "files": [
            {
              "path_env": "SURVEY_DB_PASSWORD_FILE",
              "path": "/run/secrets/survey-db-password",
              "kind": "secret",
              "schema": null,
              "required": true,
              "opened_by": "start-process"
            }
          ],
          "writable": [
            {
              "path": "/data",
              "persist": true,
              "written_by": {
                "uid": 10001,
                "gid": 10001
              }
            },
            {
              "path": "/tmp",
              "persist": false,
              "written_by": {
                "uid": 10001,
                "gid": 10001
              }
            }
          ],
          "sysctls": {}
        }
      },
      "jobs": {}
    }
  ]
}
