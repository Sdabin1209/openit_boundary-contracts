{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "IdentityDatabaseBackupEnv.schema.json",
  "title": "IdentityDatabaseBackupEnv",
  "description": "platform(identity 데이터베이스) 백업·복구 잡의 환경 변수. 이름·형식은 그 영역 서비스 Env 를 참조하고(같은 정의), 서비스 기동에만 필요한 필수 조건은 적용하지 않는다. 백업 공통 입력은 BackupJobEnv(allOf).",
  "x-producers": [
    "deploy"
  ],
  "x-consumers": [
    "platform"
  ],
  "type": "object",
  "allOf": [
    {
      "$ref": "BackupJobEnv.schema.json"
    }
  ],
  "properties": {
    "IDENTITY_PUBLIC_URL": {
      "$ref": "IdentityEnv.schema.json#/properties/IDENTITY_PUBLIC_URL"
    },
    "IDENTITY_CLIENT_SECRET_FILE": {
      "$ref": "IdentityEnv.schema.json#/properties/IDENTITY_CLIENT_SECRET_FILE"
    },
    "IDENTITY_ROOT_CA": {
      "$ref": "IdentityEnv.schema.json#/properties/IDENTITY_ROOT_CA"
    },
    "IDENTITY_DB_URL_FILE": {
      "$ref": "IdentityEnv.schema.json#/properties/IDENTITY_DB_URL_FILE"
    },
    "IDENTITY_ADMIN_PASSWORD_FILE": {
      "$ref": "IdentityEnv.schema.json#/properties/IDENTITY_ADMIN_PASSWORD_FILE"
    },
    "IDENTITY_INITIAL_ADMIN_PASSWORD_FILE": {
      "$ref": "IdentityEnv.schema.json#/properties/IDENTITY_INITIAL_ADMIN_PASSWORD_FILE"
    }
  },
  "propertyNames": {
    "$ref": "IdentityEnv.schema.json#/propertyNames"
  },
  "required": [
    "IDENTITY_DB_URL_FILE",
    "IDENTITY_ROOT_CA"
  ]
}
