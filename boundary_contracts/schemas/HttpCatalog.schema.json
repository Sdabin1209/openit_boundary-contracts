{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "HttpCatalog.schema.json",
  "title": "HttpCatalog",
  "description": "openapi/catalog.json 의 모양: 영역 서비스 HTTP 문서(openapi/<서비스>.json) 목록과 스키마 출처. 헤드가 쓰고 boundary_contracts.http_contracts.catalog 가 읽을 때 이 스키마로 검증한다.",
  "x-producers": [
    "head"
  ],
  "x-consumers": [
    "*"
  ],
  "type": "object",
  "required": [
    "version",
    "services",
    "schema_sources"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "services": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "owner",
          "document"
        ],
        "properties": {
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "document": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*\\.json$(?![\\s\\S])"
          }
        },
        "additionalProperties": false
      }
    },
    "schema_sources": {
      "const": {
        "survey": {
          "uri_prefix": "https://openit.example/survey/v1/",
          "package": "openit-survey-schema",
          "runtime_version": 1
        }
      }
    }
  },
  "additionalProperties": false
}
