{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StaffAlert",
  "description": "직원 콘솔 알림(PUBLIC_API.md). 환자 발화와 개인정보는 담지 않는다. kind는 모르는 값을 그대로 보여 준다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alert_id",
    "session_id",
    "kind",
    "created_at",
    "status"
  ],
  "properties": {
    "alert_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "description": "알림 종류. 알려진 값: RISK_STOP(위험으로 정지), CALL_STAFF(직원 호출), USER_CALLED_STAFF(환자가 직원 호출을 누름). 모르는 값은 그대로 보여 준다(읽기 모드). 직원 콘솔 목록(StaffAlert)과 세션 보기(StaffSessionView.alerts[])는 같은 이름을 쓴다. pause_reason의 RISK와는 다른 필드다."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "OPEN",
        "RESOLVED"
      ]
    },
    "resolved_by_decision": {
      "enum": [
        "RESUME",
        "END",
        null
      ]
    },
    "resolved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "pause_reason": {
      "enum": [
        "RISK",
        "REASK_LIMIT",
        "OTHER",
        null
      ],
      "description": "정지 사유(2.1.0, CR-H002). 읽는 쪽은 모르는 값을 OTHER로 취급한다. 없으면(옛 서버) 미상."
    },
    "delivery_attempts": {
      "type": "integer",
      "minimum": 0,
      "description": "전달을 시도한 횟수(첫 전달 포함, 재알림마다 1 증가, 2.1.0, CR-H001)"
    },
    "last_delivery_status": {
      "enum": [
        "DELIVERED",
        "DELIVERY_FAILED",
        null
      ],
      "description": "가장 최근 전달 시도의 결과(2.1.0)"
    },
    "manual_notice_outcome": {
      "enum": [
        "STAFF_NOTIFIED_MANUALLY",
        "NOT_NOTIFIED",
        null
      ],
      "description": "키오스크가 보고한, 현장 직원에게 직접 알렸는지(2.1.0). 보고 전에는 null 또는 생략"
    },
    "manual_notice_reported_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
