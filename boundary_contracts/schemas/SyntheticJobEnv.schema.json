{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openit.example/schemas/SyntheticJobEnv.schema.json",
  "title": "SyntheticJobEnv",
  "description": "synthetic-data run·import 잡의 환경 변수: 비밀 파일 경로와 공통 컨테이너 환경. 서버의 DATASET_STORE_* 설정은 잡 설정이 아니다. 토큰 파일 변수가 비밀 출처를 정한다(D84).",
  "x-producers": [
    "deploy"
  ],
  "x-consumers": [
    "synthetic-data"
  ],
  "type": "object",
  "allOf": [
    {
      "$ref": "CommonEnv.schema.json"
    }
  ],
  "propertyNames": {
    "anyOf": [
      {
        "not": {
          "pattern": "^(QUESTION_READER_|FAILURE_STORE_|DATASET_STORE_|OPENIT_)"
        }
      },
      {
        "enum": [
          "QUESTION_READER_TOKEN_FILE",
          "FAILURE_STORE_TOKEN_FILE",
          "DATASET_STORE_WRITE_TOKEN_FILE",
          "OPENIT_EGRESS_PROXY"
        ]
      }
    ]
  },
  "properties": {
    "QUESTION_READER_TOKEN_FILE": {
      "type": "string",
      "pattern": "^/[^\\s\\u0000]*(?![\\s\\S])"
    },
    "FAILURE_STORE_TOKEN_FILE": {
      "type": "string",
      "pattern": "^/[^\\s\\u0000]*(?![\\s\\S])"
    },
    "DATASET_STORE_WRITE_TOKEN_FILE": {
      "type": "string",
      "pattern": "^/[^\\s\\u0000]*(?![\\s\\S])"
    }
  },
  "patternProperties": {
    "_FILE$(?![\\s\\S])": {
      "type": "string",
      "pattern": "^/[^\\s\\u0000]*(?![\\s\\S])"
    }
  }
}
