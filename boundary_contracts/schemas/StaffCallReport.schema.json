{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StaffCallReport",
  "description": "POST /v1/sessions/{id}/staff-call/report 본문(2.1.0, CR-H001). 키오스크의 '직접 알리셨나요?' 응답을 서버에 남긴다.",
  "x-producers": [
    "kiosk-frontend"
  ],
  "x-consumers": [
    "survey-service"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome",
    "turn_id"
  ],
  "properties": {
    "outcome": {
      "enum": [
        "STAFF_NOTIFIED_MANUALLY",
        "NOT_NOTIFIED"
      ]
    },
    "turn_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "근거: 상한 64 는 PUBLIC_API.md 세션·턴 ID 형식과 같다"
    }
  }
}
