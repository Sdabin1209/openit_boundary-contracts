{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "QuestionFlowTable.schema.json",
  "title": "QuestionFlowTable",
  "description": "문항 순서와 건너뛰기 표(ADR 0010). LoRA-A 출력 규칙 검사(check_action_extraction)가 입력으로 받는 최소 모양이다. 문진 스키마 QuestionFlow(survey-service 소유)에서 order와 skips만 뽑아 만든다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["order", "skips"],
  "properties": {
    "order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "description": "문항 ID를 묻는 순서."},
    "skips": {
      "type": "array",
      "description": "slot에 저장된 값이 value와 같으면(op '==') skip_item은 묻지 않는다. bool과 수는 다르다(true != 1).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "op", "value", "skip_item"],
        "properties": {
          "slot": {"type": "string", "pattern": "^[A-Za-z0-9_.]+\\.[A-Za-z0-9_]+$", "description": "문항.칸 (종류 괄호 없음). 예: Q8_1.days"},
          "op": {"const": "=="},
          "value": {"type": ["boolean", "number", "string"]},
          "skip_item": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
