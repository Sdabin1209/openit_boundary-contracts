{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://openit.example/schemas/DatasetStoreEnv.schema.json",
 "title": "DatasetStoreEnv",
 "description": "dataset-store 서비스(synthetic-data 소유) 컨테이너의 환경 변수 선언 (3.2.0, U73: 영역 사이 설정 이름은 이 선언에만 있다. deploy 는 여기 있는 이름만 주고, 서비스는 기동 때 자기 environ 을 이 스키마로 검증한다. 접두사가 붙은 이름 중 여기 없는 것은 거부, 접두사 없는 다른 변수(PATH 등)는 보지 않는다.)",
 "x-producers": [
  "deploy"
 ],
 "x-consumers": [
  "synthetic-data"
 ],
 "type": "object",
 "$defs": {
  "Port": {
   "type": "string",
   "pattern": "^([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$(?![\\s\\S])",
   "description": "TCP 포트 1~65535"
  },
  "Int": {
   "type": "string",
   "pattern": "^[0-9]+$(?![\\s\\S])",
   "description": "0 이상 정수"
  },
  "PosInt": {
   "type": "string",
   "pattern": "^[1-9][0-9]*$(?![\\s\\S])",
   "description": "1 이상 정수"
  },
  "Seconds": {
   "type": "string",
   "pattern": "^[0-9]+(\\.[0-9]+)?$(?![\\s\\S])",
   "description": "초(소수 허용, 0 이상)"
  },
  "Flag1": {
   "type": "string",
   "enum": [
    "1"
   ],
   "description": "켜려면 정확히 '1'. 없음 = 꺼짐"
  },
  "Path": {
   "type": "string",
   "minLength": 1,
   "description": "컨테이너 안 절대 경로"
  },
  "RoleTokenList": {
   "type": "string",
   "minLength": 1,
   "description": "'역할=토큰,역할=토큰'"
  },
  "CsvRoles": {
   "type": "string",
   "pattern": "^[a-z0-9-]+(,[a-z0-9-]+)*$(?![\\s\\S])",
   "description": "쉼표로 구분한 역할 이름 목록"
  }
 },
 "propertyNames": {
  "anyOf": [
   {
    "not": {
     "pattern": "^(DATASET_STORE_)"
    }
   },
   {
    "enum": [
     "DATASET_STORE_AUTH_FAIL_LIMIT",
     "DATASET_STORE_DRAIN_GRACE",
     "DATASET_STORE_HOST",
     "DATASET_STORE_MAX_BODY",
     "DATASET_STORE_MAX_CONNECTIONS",
     "DATASET_STORE_MAX_DOWNLOADS",
     "DATASET_STORE_MAX_ENTRIES",
     "DATASET_STORE_MAX_PUBLISHES",
     "DATASET_STORE_MIN_FREE_GB",
     "DATASET_STORE_MIN_TOKEN_LEN",
     "DATASET_STORE_PORT",
     "DATASET_STORE_READ_TOKENS",
     "DATASET_STORE_READ_TOKENS_FILE",
     "DATASET_STORE_ROOT",
     "DATASET_STORE_SOCKET_TIMEOUT",
     "DATASET_STORE_SURVEY_SCHEMA_DIR",
     "DATASET_STORE_THREADS",
     "DATASET_STORE_WRITE_TOKENS",
     "DATASET_STORE_WRITE_TOKENS_FILE"
    ]
   }
  ]
 },
 "properties": {
  "DATASET_STORE_READ_TOKENS_FILE": {
   "$ref": "#/$defs/Path",
   "description": "비밀(D84): 읽기 경로 토큰 목록(역할=토큰). 파일 경로"
  },
  "DATASET_STORE_READ_TOKENS": {
   "$ref": "#/$defs/RoleTokenList",
   "description": "개발·시험 호환: 읽기 경로 토큰 목록(역할=토큰). 운영 금지(운영은 DATASET_STORE_READ_TOKENS_FILE)"
  },
  "DATASET_STORE_WRITE_TOKENS_FILE": {
   "$ref": "#/$defs/Path",
   "description": "비밀(D84): 게시(POST) 토큰. 쓰기 역할은 synthetic-data 만. 파일 경로"
  },
  "DATASET_STORE_WRITE_TOKENS": {
   "$ref": "#/$defs/RoleTokenList",
   "description": "개발·시험 호환: 게시(POST) 토큰. 쓰기 역할은 synthetic-data 만. 운영 금지(운영은 DATASET_STORE_WRITE_TOKENS_FILE)"
  },
  "DATASET_STORE_ROOT": {
   "$ref": "#/$defs/Path",
   "description": "저장 볼륨",
   "default": "/data"
  },
  "DATASET_STORE_SURVEY_SCHEMA_DIR": {
   "$ref": "#/$defs/Path",
   "description": "문진 스키마 디렉터리(CONTRACT_VERSION 과 schemas/)",
   "default": "/app/survey_schema"
  },
  "DATASET_STORE_HOST": {
   "type": "string",
   "minLength": 1,
   "description": "바인드 주소",
   "default": "0.0.0.0"
  },
  "DATASET_STORE_PORT": {
   "$ref": "_common.schema.json#/$defs/BindPort",
   "description": "바인드 포트. 0이면 빈 포트. 주의: Dockerfile 의 HEALTHCHECK 는 8080 고정",
   "default": "8080"
  },
  "DATASET_STORE_MAX_BODY": {
   "$ref": "#/$defs/PosInt",
   "description": "게시 본문 최대 바이트(waitress max_request_body_size)",
   "default": "1073741824"
  },
  "DATASET_STORE_SOCKET_TIMEOUT": {
   "$ref": "#/$defs/Seconds",
   "description": "유휴 연결 timeout 초",
   "default": "30"
  },
  "DATASET_STORE_MAX_CONNECTIONS": {
   "$ref": "#/$defs/PosInt",
   "description": "동시 연결 상한",
   "default": "32"
  },
  "DATASET_STORE_THREADS": {
   "$ref": "#/$defs/PosInt",
   "description": "작업 스레드 수(동시 게시 8 + 동시 다운로드 8)",
   "default": "16"
  },
  "DATASET_STORE_DRAIN_GRACE": {
   "$ref": "#/$defs/Seconds",
   "description": "종료 신호 뒤 진행 중 요청을 기다리는 최대 초",
   "default": "8"
  },
  "DATASET_STORE_MAX_PUBLISHES": {
   "$ref": "#/$defs/PosInt",
   "description": "동시 게시 상한",
   "default": "8"
  },
  "DATASET_STORE_MAX_DOWNLOADS": {
   "$ref": "#/$defs/PosInt",
   "description": "동시 다운로드 상한",
   "default": "8"
  },
  "DATASET_STORE_MAX_ENTRIES": {
   "$ref": "#/$defs/PosInt",
   "description": "게시 tar 안 항목 수 상한(푸는 도중 넘으면 거부)",
   "default": "1000"
  },
  "DATASET_STORE_AUTH_FAIL_LIMIT": {
   "$ref": "#/$defs/PosInt",
   "description": "같은 주소의 인증 실패 상한(60초 창)",
   "default": "10"
  },
  "DATASET_STORE_MIN_FREE_GB": {
   "$ref": "#/$defs/Seconds",
   "description": "게시 전 요구 여유 공간 GB",
   "default": "1"
  },
  "DATASET_STORE_MIN_TOKEN_LEN": {
   "$ref": "#/$defs/PosInt",
   "description": "토큰 최소 길이(128비트 16진수)",
   "default": "32"
  }
 },
 "anyOf": [
  {
   "required": [
    "DATASET_STORE_READ_TOKENS_FILE"
   ]
  },
  {
   "required": [
    "DATASET_STORE_READ_TOKENS"
   ]
  },
  {
   "required": [
    "DATASET_STORE_WRITE_TOKENS_FILE"
   ]
  },
  {
   "required": [
    "DATASET_STORE_WRITE_TOKENS"
   ]
  }
 ]
}
