{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "HttpWire.schema.json",
  "title": "HttpWire",
  "description": "HTTP 경로 매개변수·헤더·바이너리 본문의 공통 형식 묶음($defs: Binary, User(X-Openit-User), Id, SessionId, FilePath, EventId). openapi 문서와 http_contracts 가 가리킨다.",
  "x-producers": [
    "*"
  ],
  "x-consumers": [
    "*"
  ],
  "$defs": {
    "Binary": {
      "type": "string",
      "format": "binary"
    },
    "User": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._@:+/#=-]{1,128}$(?![\\s\\S])"
    },
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$(?![\\s\\S])"
    },
    "SessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$(?![\\s\\S])"
    },
    "FilePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$(?![\\s\\S])))(?!.*\\\\).+$(?![\\s\\S])"
    },
    "EventId": {
      "type": "string",
      "pattern": "^[0-9]+$(?![\\s\\S])"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/Binary"
    },
    {
      "$ref": "#/$defs/User"
    },
    {
      "$ref": "#/$defs/Id"
    },
    {
      "$ref": "#/$defs/SessionId"
    },
    {
      "$ref": "#/$defs/FilePath"
    },
    {
      "$ref": "#/$defs/EventId"
    }
  ]
}
