{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "OpsFeedbackJobConfig.schema.json",
 "title": "OpsFeedbackJobConfig",
 "description": "ops-feedback 주기 잡 설정(YAML을 객체로 읽은 것). 만드는 쪽: deploy(운영) 또는 이 영역의 예시. 읽는 쪽: ops-feedback `python -m ops_feedback.job --config`. 모르는 키는 어디서나 거부한다(오타가 조용히 무시되어 비식별·보존 설정이 꺼지는 것을 막는다). 비밀 값은 적을 수 없고 {secret: NAME}만 쓴다(D84). 3.7.0(D9): release_reader·gate_service 는 HttpClientSettings(구현 모듈 경로 factory 를 없앴다), detection.detectors 는 내장 규칙 탐지기(type rule)만(임의 factory 탐지기는 운영 사용처가 없고 시험 대역 주입 칸이었다).",
 "x-producers": [
  "deploy"
 ],
 "x-consumers": [
  "ops-feedback"
 ],
 "type": "object",
 "additionalProperties": false,
 "required": [
  "storage",
  "deid",
  "detection",
  "classification",
  "retention"
 ],
 "properties": {
  "storage": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "log_db",
    "failure_db"
   ],
   "description": "SQLite 경로. 환경 변수 OPS_LOG_DATABASE_URL[_FILE] / OPS_FAILURE_DATABASE_URL[_FILE]가 있으면 PostgreSQL이 우선하고 이 경로는 쓰이지 않는다.",
   "properties": {
    "log_db": {
     "type": "string",
     "minLength": 1
    },
    "failure_db": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "deid": {
   "$ref": "#/$defs/Deid"
  },
  "detection": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "detectors"
   ],
   "properties": {
    "detectors": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/Detector"
     }
    }
   }
  },
  "classification": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "default_failure_type"
   ],
   "properties": {
    "default_failure_type": {
     "$ref": "_common.schema.json#/$defs/FailureType",
     "description": "규칙에 대응이 없을 때의 실패 유형(FailureCase.failure_type). 값 목록은 설치처가 정한다"
    },
    "rule_to_type": {
     "type": "object",
     "propertyNames": {
      "$ref": "#/$defs/RuleId"
     },
     "additionalProperties": {
      "$ref": "_common.schema.json#/$defs/FailureType"
     },
     "description": "탐지 규칙 ID -> 실패 유형(FailureCase.failure_type)"
    },
    "priority": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/RuleId"
     }
    }
   }
  },
  "retention": {
   "type": "object",
   "additionalProperties": false,
   "description": "일 수(0 초과) 또는 \"forever\". null은 거부(기본 무기한 금지). 생략하면 raw 30, cases 180, metrics 365(ADR 0007).",
   "properties": {
    "raw_days": {
     "$ref": "#/$defs/DaysOrForever"
    },
    "cases_days": {
     "$ref": "#/$defs/DaysOrForever"
    },
    "metrics_days": {
     "$ref": "#/$defs/DaysOrForever"
    },
    "failed_raw_days": {
     "$ref": "#/$defs/DaysOrForever"
    },
    "purge_unprocessed": {
     "type": "boolean"
    },
    "cases_purge_confirmed": {
     "type": "boolean"
    },
    "raw_after_processing": {
     "enum": [
      "keep",
      "minimize"
     ]
    }
   }
  },
  "job": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "batch_size": {
     "type": "integer",
     "minimum": 1
    }
   }
  },
  "rollback": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "window_hours",
    "min_turns",
    "max_failure_rate",
    "counted_review_statuses",
    "requested_by_role",
    "auto_submit"
   ],
   "description": "있으면 롤백 평가를 한다(release_reader도 있어야 평가가 돈다). 기준 값은 사용자 결정이며 기본값이 없다.",
   "properties": {
    "window_hours": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "min_turns": {
     "type": "integer",
     "minimum": 1
    },
    "max_failure_rate": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "counted_review_statuses": {
     "type": "array",
     "minItems": 1,
     "items": {
      "const": "CONFIRMED"
     },
     "description": "롤백 평가에 세는 사례의 검토 상태. 3.2.0(CR-012, L07): 사람이 확정한 CONFIRMED 만 허용한다. 자동 탐지(PENDING)만으로 롤백 요청이 나가면 위조 Trace 로 롤백을 일으킬 수 있다"
    },
    "requested_by_role": {
     "type": "string",
     "minLength": 1
    },
    "auto_submit": {
     "type": "boolean"
    },
    "deadline_seconds": {
     "type": "number",
     "exclusiveMinimum": 0
    }
   }
  },
  "release_reader": {
   "$ref": "_common.schema.json#/$defs/HttpClientSettings",
   "description": "릴리스 읽기(release-gate I4, 계약 클라이언트 HttpReleaseReader). 롤백 평가를 할 때 필요"
  },
  "gate_service": {
   "$ref": "_common.schema.json#/$defs/HttpClientSettings",
   "description": "롤백 요청 제출(release-gate, 계약 클라이언트 HttpGateService). rollback.auto_submit 일 때 필요"
  }
 },
 "$defs": {
  "DaysOrForever": {
   "oneOf": [
    {
     "type": "number",
     "exclusiveMinimum": 0
    },
    {
     "const": "forever"
    }
   ]
  },
  "RuleId": {
   "enum": [
    "TURN_FAILURE_SIGNAL",
    "TURN_FAILED_STEPS",
    "COMMIT_ERROR",
    "RESPONSE_FALLBACK",
    "STAFF_ALERT_DELIVERY_FAILED",
    "INTERVENTION_FAILED",
    "EXTRACT_FAILED",
    "REASK_STREAK"
   ]
  },
  "SecretRef": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "secret"
   ],
   "properties": {
    "secret": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "Detector": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "type",
    "rules"
   ],
   "properties": {
    "type": {
     "const": "rule"
    },
    "rules": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Rule"
     }
    }
   }
  },
  "Rule": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id"
   ],
   "properties": {
    "id": {
     "$ref": "#/$defs/RuleId"
    },
    "enabled": {
     "type": "boolean"
    },
    "params": {
     "type": "object"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "id": {
        "const": "REASK_STREAK"
       }
      },
      "required": [
       "id"
      ]
     },
     "then": {
      "required": [
       "params"
      ],
      "properties": {
       "params": {
        "type": "object",
        "required": [
         "threshold"
        ],
        "additionalProperties": false,
        "properties": {
         "threshold": {
          "type": "integer",
          "minimum": 1
         },
         "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
           "type": "string",
           "minLength": 1
          }
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "id": {
        "const": "EXTRACT_FAILED"
       }
      },
      "required": [
       "id"
      ]
     },
     "then": {
      "properties": {
       "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "empty_values_ok_actions": {
          "type": "array",
          "items": {
           "type": "string"
          }
         }
        }
       }
      }
     }
    }
   ]
  },
  "Deid": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "policy_id",
    "keep_string_keys",
    "unlisted_string_action"
   ],
   "description": "비식별 정책. 기본값 없음(사용자 결정). 고를 수 있는 범위는 공개 규칙 boundary_contracts/data/deid_rules.json 이 정하고 출력 모양은 OpsFeedbackDeidentifiedTrace·OpsFeedbackReviewTrace(그 규칙에서 생성)가 정한다(3.7.0). session_id·turn_id 는 반드시 가명화한다(pseudonymize_keys 에 둘 다): admin delete-session 과 조회가 이 의사 식별자로 비식별 trace 를 찾는다. 두 키는 keep·mask_value 로 겹쳐 지정할 수 없고 그 정의(SessionId)를 mask_defs·drop_defs 로 가릴 수 없다. 3.0.0(U25): 계약 OpsFeedbackDeidentifiedTrace 밖 출력을 내던 선택지(scrub_string_keys·scrub_patterns 치환 문장, unlisted_string_action drop, count_map_key_pattern)를 뺐다.",
   "properties": {
    "policy_id": {
     "type": "string",
     "minLength": 1
    },
    "salt_env": {
     "type": "string",
     "pattern": "^[A-Z][A-Z0-9_]*$(?![\\s\\S])",
     "description": "salt 비밀의 이름. 값은 <이름>_FILE 파일에서 읽는다. 기본 OPS_DEID_SALT"
    },
    "pseudonymize_keys": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "enum": [
       "session_id",
       "turn_id"
      ]
     },
     "allOf": [
      {
       "contains": {
        "const": "session_id"
       }
      },
      {
       "contains": {
        "const": "turn_id"
       }
      }
     ],
     "description": "가명화할 키. 정확히 session_id·turn_id(3.7.0: 둘 다 필수, 다른 키는 출력 계약 밖)"
    },
    "keep_string_keys": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "enum": [
       "question_id",
       "next_item",
       "current_question_id",
       "slot_id",
       "repeat_key",
       "code",
       "action",
       "path"
      ]
     },
     "description": "원문 대신 식별자 모양 값을 남길 키. deid_rules.json keep_patterns 의 키 중에서만(그 패턴에 전체 일치할 때만 남고, 아니면 [MASKED])"
    },
    "keep_string_patterns": {
     "type": "object",
     "propertyNames": {
      "enum": [
       "question_id",
       "next_item",
       "current_question_id",
       "slot_id",
       "repeat_key",
       "code",
       "action",
       "path"
      ]
     },
     "additionalProperties": {
      "type": "string",
      "format": "regex"
     },
     "description": "키별 추가 거르개(3.7.0): 값은 deid_rules.json 의 기본 패턴과 이 패턴 둘 다에 전체 일치해야 남는다. 기본보다 넓힐 수 없다(그 전에는 기본을 바꿔치기해 출력 계약 밖 값을 낼 수 있었다)"
    },
    "keep_count_map_keys": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "$ref": "#/$defs/DeidCountMapKey"
     }
    },
    "keep_pause_reason": {
     "type": "boolean"
    },
    "unlisted_string_action": {
     "const": "mask",
     "description": "3.0.0(U25, ops-feedback CR-008 안 2): mask만. drop은 비식별 뷰(OpsFeedbackDeidentifiedTrace)의 필수 칸을 빠뜨려 계약 밖 출력을 냈다"
    },
    "mask_defs": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "$ref": "#/$defs/DeidDefName"
     },
     "description": "문진 스키마 TurnTrace 의 정의 이름. 그 정의를 거친 위치를 통째로 [MASKED] 로 바꾼다"
    },
    "drop_defs": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "$ref": "#/$defs/DeidDefName"
     },
     "description": "문진 스키마 TurnTrace 의 정의 이름. 그 정의를 거친 위치를 통째로 [DROPPED] 로 바꾼다"
    },
    "mask_value_keys": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1,
      "not": {
       "enum": [
        "session_id",
        "turn_id"
       ]
      }
     },
     "description": "타입과 상관없이 값을 통째로 [MASKED] 로 바꿀 키(가명 키는 안 된다)"
    },
    "mask_number_keys": {
     "$ref": "#/$defs/StrList"
    },
    "residual_patterns": {
     "$ref": "#/$defs/RegexMap"
    },
    "review_utterance": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "keep"
     ],
     "properties": {
      "keep": {
       "type": "boolean"
      },
      "max_chars": {
       "type": "integer",
       "minimum": 1,
       "maximum": 1000,
       "default": 1000
      }
     },
     "description": "3.2.0(L12, 사용자 결정 2026-11-03): keep=true 면 검토 사본(OpsFeedbackReviewTrace, GET /v1/review-traces/{ref})에 발화 두 칸(frontend_message.utterance, extract_input.user_utterance)만 원문으로 보존한다. 경로 지정이며 키 이름 기준(keep_string_keys)이 아니다. 비식별 뷰(get_trace)는 영향 없음. 정책 지문이 바뀌므로 기존 PENDING 사례는 재처리되지 않는다"
    }
   }
  },
  "StrList": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "RegexMap": {
   "type": "object",
   "additionalProperties": {
    "type": "string",
    "format": "regex"
   }
  },
  "DeidDefName": {
   "enum": [
    "AlertKind",
    "AnswerUpdate",
    "CodedValue",
    "CurrentValue",
    "Decision",
    "DispatchInput",
    "DispatchOutput",
    "DispatchRecord",
    "ExtractionInputRecord",
    "ExtractionRecord",
    "FailedStep",
    "FrontendInput",
    "FrontendMessage",
    "HistoryEntry",
    "InputKind",
    "InterventionDecision",
    "InterventionResult",
    "LogEntry",
    "OpenSlot",
    "OrchestratorInput",
    "OrchestratorOutput",
    "PauseEntry",
    "PauseKind",
    "PauseReason",
    "Precision",
    "ProgressRecord",
    "ProgressRecordUpdate",
    "Protections",
    "QuestionId",
    "ResponseRequestRecord",
    "RevisionToken",
    "RiskResponse",
    "SessionCommitRequest",
    "SessionCommitResult",
    "SessionInfo",
    "SessionLoadRequest",
    "SessionLoadResult",
    "SessionStatus",
    "SessionStore",
    "SkipEntry",
    "SkipReason",
    "SlotRecord",
    "SlotRef",
    "SourceText",
    "StaffAlert",
    "StaffAlertReason",
    "StaffConsoleInput",
    "TurnFailureSignal",
    "TurnKind",
    "TurnWriteSet",
    "Value",
    "ViolationRecord"
   ],
   "description": "문진 스키마 TurnTrace v1 에서 $ref 로 도달하는 정의 이름(가명 키의 SessionId 제외). 생성: tools/gen_deid_view.py"
  },
  "DeidCountMapKey": {
   "enum": [
    "extract_protections",
    "response_protections"
   ],
   "description": "건수 맵으로 남길 수 있는 키(properties 없고 additionalProperties 가 integer 인 위치의 키). 생성: tools/gen_deid_view.py"
  }
 }
}
