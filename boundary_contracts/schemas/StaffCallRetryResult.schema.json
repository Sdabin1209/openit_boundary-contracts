{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StaffCallRetryResult",
  "description": "재알림 응답(2.1.0, CR-H001). 같은 alert_id로 다시 전달한 결과.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alert_id",
    "staff_alert",
    "delivery_attempts",
    "retry_after_s"
  ],
  "properties": {
    "alert_id": {
      "type": "string",
      "minLength": 1
    },
    "staff_alert": {
      "enum": [
        "DELIVERED",
        "DELIVERY_FAILED"
      ]
    },
    "delivery_attempts": {
      "type": "integer",
      "minimum": 1
    },
    "retry_after_s": {
      "type": "integer",
      "minimum": 0,
      "description": "이 초가 지나기 전의 재알림은 429. 값은 서비스 설정이며 계약이 아니다."
    }
  }
}
