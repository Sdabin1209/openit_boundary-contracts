{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "BackupJobEnv.schema.json",
  "title": "BackupJobEnv",
  "description": "백업·복구 잡 프로세스의 입력. 서버 기동용 인증(토큰)은 필요 없다. 파일 내용과 마운트되는 저장소는 ContainerInputs 가 선언한다. OPENIT_ 이름은 공통 백업 입력과 출구 프록시로 한정하고, 그 밖의 이름 공간은 영역 Env 가 검사한다. 저장소 URL 은 https, 선택 TCP 포트 1~65535, 비어 있지 않은 저장소 경로이며 인증은 선언된 파일로만 받는다(URL userinfo 거부). URI 쿼리·조각 문법은 허용한다(HTTP 는 조각을 보내지 않는다). POSIX 파일 경로는 절대 경로이고 NUL 이 없다. 10진 포트의 앞자리 0 은 받아들이고, 포트가 없으면 https 기본 포트다.",
  "x-producers": [
    "deploy"
  ],
  "x-consumers": [
    "*"
  ],
  "type": "object",
  "allOf": [
    {
      "$ref": "CommonEnv.schema.json"
    }
  ],
  "required": [
    "OPENIT_BACKUP_URL",
    "OPENIT_BACKUP_CREDENTIALS_FILE",
    "OPENIT_BACKUP_REPO_PASSWORD_FILE"
  ],
  "properties": {
    "OPENIT_BACKUP_URL": {
      "allOf": [
        {
          "$ref": "CommonEnv.schema.json#/properties/OPENIT_BACKUP_URL"
        },
        {
          "format": "uri"
        },
        {
          "pattern": "^https://(?:\\[[0-9A-Fa-f:.]+\\]|[^:/@?#\\s]+)(?::(?:0*(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?)?/[^?#\\s]+(?:\\?[^#\\s]*)?(?:#[^\\s]*)?(?![\\s\\S])"
        }
      ]
    },
    "OPENIT_BACKUP_CREDENTIALS_FILE": {
      "allOf": [
        {
          "$ref": "CommonEnv.schema.json#/properties/OPENIT_BACKUP_CREDENTIALS_FILE"
        },
        {
          "pattern": "^/[^\\u0000]*(?![\\s\\S])"
        }
      ]
    },
    "OPENIT_BACKUP_REPO_PASSWORD_FILE": {
      "allOf": [
        {
          "$ref": "CommonEnv.schema.json#/properties/OPENIT_BACKUP_REPO_PASSWORD_FILE"
        },
        {
          "pattern": "^/[^\\u0000]*(?![\\s\\S])"
        }
      ]
    }
  },
  "propertyNames": {
    "anyOf": [
      {
        "not": {
          "pattern": "^OPENIT_"
        }
      },
      {
        "enum": [
          "OPENIT_EGRESS_PROXY",
          "OPENIT_BACKUP_URL",
          "OPENIT_BACKUP_CREDENTIALS_FILE",
          "OPENIT_BACKUP_REPO_PASSWORD_FILE"
        ]
      }
    ]
  }
}
