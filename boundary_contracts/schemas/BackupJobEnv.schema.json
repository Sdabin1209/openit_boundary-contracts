{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "BackupJobEnv.schema.json",
  "title": "BackupJobEnv",
  "description": "Backup/restore process inputs. Server startup authentication is not required. File contents and mounted storage remain declared by ContainerInputs. OPENIT_ names are limited to the common backup inputs and egress proxy; other namespaces are checked by the area Env. Repository URLs use HTTPS, an optional TCP port 1..65535, and a nonempty repository path. Authentication is supplied exclusively through the declared files; URL userinfo is rejected. URI query and fragment syntax remain supported; HTTP does not transmit the fragment. POSIX file paths must be absolute and contain no NUL.",
  "x-producers": [
    "deploy"
  ],
  "x-consumers": [
    "*"
  ],
  "type": "object",
  "allOf": [
    {
      "$ref": "CommonEnv.schema.json"
    }
  ],
  "required": [
    "OPENIT_BACKUP_URL",
    "OPENIT_BACKUP_CREDENTIALS_FILE",
    "OPENIT_BACKUP_REPO_PASSWORD_FILE"
  ],
  "properties": {
    "OPENIT_BACKUP_URL": {
      "allOf": [
        {
          "$ref": "CommonEnv.schema.json#/properties/OPENIT_BACKUP_URL"
        },
        {
          "format": "uri"
        },
        {
          "pattern": "^https://(?:\\[[0-9A-Fa-f:.]+\\]|[^:/@?#\\s]+)(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?/[^?#\\s]+(?:\\?[^#\\s]*)?(?:#[^\\s]*)?(?![\\s\\S])"
        }
      ]
    },
    "OPENIT_BACKUP_CREDENTIALS_FILE": {
      "allOf": [
        {
          "$ref": "CommonEnv.schema.json#/properties/OPENIT_BACKUP_CREDENTIALS_FILE"
        },
        {
          "pattern": "^/[^\\u0000]*(?![\\s\\S])"
        }
      ]
    },
    "OPENIT_BACKUP_REPO_PASSWORD_FILE": {
      "allOf": [
        {
          "$ref": "CommonEnv.schema.json#/properties/OPENIT_BACKUP_REPO_PASSWORD_FILE"
        },
        {
          "pattern": "^/[^\\u0000]*(?![\\s\\S])"
        }
      ]
    }
  },
  "propertyNames": {
    "anyOf": [
      {
        "not": {
          "pattern": "^OPENIT_"
        }
      },
      {
        "enum": [
          "OPENIT_EGRESS_PROXY",
          "OPENIT_BACKUP_URL",
          "OPENIT_BACKUP_CREDENTIALS_FILE",
          "OPENIT_BACKUP_REPO_PASSWORD_FILE"
        ]
      }
    ]
  }
}
