            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/ActionExtraction.schema.json"
                }
              }
            },
            "headers": {
              "X-Openit-Outcome": {
                "required": true,
                "schema": {
                  "type": "string",
                  "enum": [
                    "ok"
                  ],
                  "description": "출력 결과(HTTP.md I9). 없으면 클라이언트는 INTEGRITY_ERROR(4.0.5 선언)"
                }
              },
              "X-Openit-Attempts": {
                "required": false,
                "schema": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$(?![\\s\\S])",
                  "description": "모델 호출 시도 횟수(HTTP.md I9). 양의 정수, 앞자리 0 없음(SDK clients/runtime.py 는 이보다 너그럽게 읽는다)"
                }
              },
              "X-Openit-Protections": {
                "required": false,
                "schema": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*:[0-9]+(,[A-Za-z][A-Za-z0-9_]*:[0-9]+)*$(?![\\s\\S])",
                  "description": "보호 규칙 코드별 적용 건수, 쉼표 구분(HTTP.md I9; 코드 값은 model-runtime 이 정한다). 보호가 없으면 헤더를 붙이지 않는다(빈 값 금지). 코드 문법은 SDK _PROTECTION 과 같다"
                }
              }
            }
